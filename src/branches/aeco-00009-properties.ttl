    skos:broader aeco:aeco-00928 ;
    skos:notation "aeco-00965" ;
    skos:prefLabel "Redundancy level"@en-US , "Redundancy level"@en-GB ;
    skos:altLabel "equipment redundancy"@en-US ,
        "redundancy configuration"@en-US ;
    skos:definition "The number of spare components or paths beyond what the load needs, written as N, N+1, 2N or 2N+1."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00966 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00928 ;
    skos:notation "aeco-00966" ;
    skos:prefLabel "Cleanroom class"@en-US , "Cleanroom class"@en-GB ;
    skos:altLabel "ISO class"@en-US ,
        "cleanliness class"@en-US ,
        "particle class"@en-US ;
    skos:definition "The maximum count of airborne particles allowed per volume of air in a controlled space."@en ;
    skos:scopeNote "Classes follow ISO 14644-1. Applies to a Cleanroom (aeco-00573)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00967 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00928 ;
    skos:notation "aeco-00967" ;
    skos:prefLabel "Biosafety level"@en-US , "Containment level"@en-GB ;
    skos:altLabel "BSL"@en-US ,
        "biocontainment level"@en-US ;
    skos:definition "The degree of containment, from 1 to 4, that a laboratory provides for the biological agents handled in it."@en ;
    skos:scopeNote "Follows the BMBL in the US. Applies to a Laboratory (aeco-00572)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .
