    skos:notation "aeco-00920" ;
    skos:prefLabel "Unit cost"@en-US , "Unit cost"@en-GB ;
    skos:altLabel "cost per unit"@en-US ;
    skos:definition "The cost of one unit of work or material, such as dollars per square foot."@en ;
