aeco:aeco-00964 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00928 ;
    skos:notation "aeco-00964" ;
    skos:prefLabel "Data center tier"@en-US , "Data centre tier"@en-GB ;
    skos:altLabel "availability class"@en-US ,
        "data center rating"@en-US ,
        "tier level"@en-US ,
        "data centre rating"@en-GB ;
    skos:hiddenLabel "Uptime Tier"@en-US ;
    skos:definition "A rating from 1 to 4 of how well the power and cooling of a data hall keep running during maintenance or faults."@en ;
    skos:scopeNote "Ratings come from TIA-942 and the Uptime Institute. Applies to a Data center (aeco-00501)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00965 a skos:Concept ;
