aeco:aeco-00001 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00001" ;
    skos:prefLabel "Built assets"@en-US , "Built assets"@en-GB ;
    skos:altLabel "construction complex"@en-US ,
        "construction entity"@en-US ,
        "facility"@en-US ;
