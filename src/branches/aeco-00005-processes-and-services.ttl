aeco:aeco-00955 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00174 ;
    skos:notation "aeco-00955" ;
    skos:prefLabel "Document control"@en-US , "Document control"@en-GB ;
    skos:altLabel "document management"@en-US ,
