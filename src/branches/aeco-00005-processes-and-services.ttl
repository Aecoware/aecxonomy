    skos:broader aeco:aeco-00174 ;
    skos:notation "aeco-00195" ;
    skos:prefLabel "Risk management"@en-US , "Risk management"@en-GB ;
    skos:altLabel "risk control"@en-US ;
    skos:definition "The steps that find, rate and treat threats and opportunities before they affect the project."@en ;
    skos:scopeNote "The risk types are in Events and risks"@en ;
