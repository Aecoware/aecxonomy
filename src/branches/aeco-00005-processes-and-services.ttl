aeco:aeco-00005 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00005" ;
    skos:prefLabel "Processes and services"@en-US , "Processes and services"@en-GB ;
    skos:altLabel "construction process"@en-US ,
        "management process"@en-US ;
    skos:definition "A set of steps that people do to manage, design, build or operate a built asset. It includes work that one party does for another party."@en ;
    skos:scopeNote "Procurement, change management, inspection, commissioning, SOPs"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Process" ;
    aeco:depthLimit 3 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00174 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00005 ;
    skos:notation "aeco-00174" ;
    skos:prefLabel "Project management processes"@en-US , "Project management processes"@en-GB ;
    skos:altLabel "management processes"@en-US ;
    skos:definition "The steps that a team uses to plan, track and control scope, time, cost, risk and change."@en ;
    skos:scopeNote "Scope, schedule, cost, risk, change, procurement, stakeholders"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00192 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00174 ;
    skos:notation "aeco-00192" ;
    skos:prefLabel "Scope management"@en-US , "Scope management"@en-GB ;
    skos:altLabel "scope control"@en-US ;
    skos:definition "The steps that define what work is in the project and control additions to it."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00193 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00174 ;
    skos:notation "aeco-00193" ;
    skos:prefLabel "Schedule management"@en-US ;
    skos:altLabel "scheduling"@en-US ,
