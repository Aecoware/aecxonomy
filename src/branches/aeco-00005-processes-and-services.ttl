aeco:aeco-00954 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00174 ;
    skos:notation "aeco-00954" ;
    skos:prefLabel "Progress meeting"@en-US , "Progress meeting"@en-GB ;
