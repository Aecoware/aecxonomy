        "programme management of time"@en-GB ;
    skos:definition "The steps that plan the order and dates of the work and track progress against the plan."@en ;
    skos:scopeNote "UK says programme for schedule. Not a label here, to avoid a clash with Programme management"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
