aeco:aeco-00010 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00010" ;
    skos:prefLabel "Regulations and permits"@en-US , "Regulations and permits"@en-GB ;
    skos:altLabel "codes and regulations"@en-US ,
        "regulatory requirements"@en-US ,
        "consents"@en-GB ;
    skos:definition "A rule that an authority makes and enforces, and the approval that the authority gives to do work. Examples are a building code and a building permit."@en ;
    skos:scopeNote "Building codes, zoning, permits, OSHA rules. Authorities sit under Roles"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Added" ;
    aeco:depthLimit 3 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00286 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00010 ;
    skos:notation "aeco-00286" ;
    skos:prefLabel "Construction codes"@en-US , "Construction codes"@en-GB ;
    skos:altLabel "adopted codes"@en-US ,
        "model codes"@en-US ;
    skos:definition "The sets of rules that an authority adopts into law to control how people design and build. Each jurisdiction adopts its own editions and local changes."@en ;
    skos:scopeNote "Building, fire, energy and system codes. The project records the editions and local amendments that apply (context schema 4.3)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00307 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00286 ;
    skos:notation "aeco-00307" ;
    skos:prefLabel "Building code"@en-US , "Building regulations"@en-GB ;
    skos:definition "A set of minimum rules that new and altered facilities must meet for structure, fire safety, access, health and energy use."@en ;
    skos:scopeNote "US: the IBC, adopted by most states with local amendments. UK: the Building Regulations and their Approved Documents"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00308 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00286 ;
    skos:notation "aeco-00308" ;
    skos:prefLabel "Residential code"@en-US ;
    skos:altLabel "one- and two-family dwelling code"@en-US ;
    skos:definition "A set of minimum rules for one- and two-family dwellings and townhouses up to three stories high."@en ;
    skos:scopeNote "US: the IRC"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-icc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00309 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00286 ;
    skos:notation "aeco-00309" ;
    skos:prefLabel "Existing building code"@en-US ;
    skos:altLabel "rehabilitation code"@en-US ;
    skos:definition "A set of rules for repair, alteration, addition and change of use in a facility that is already built."@en ;
    skos:scopeNote "US: the IEBC. UK alterations follow the Building Regulations"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-icc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00310 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00286 ;
    skos:notation "aeco-00310" ;
    skos:prefLabel "Fire code"@en-US ;
    skos:altLabel "fire prevention code"@en-US ;
    skos:definition "A set of rules that controls ignition sources, hazardous materials, alarm and sprinkler systems and emergency access, during construction and use."@en ;
    skos:scopeNote "US: the IFC or NFPA 1, as the state adopts. Enforced by the Fire marshal (aeco-00116)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-icc , aeco:std-nfpa ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00311 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00286 ;
    skos:notation "aeco-00311" ;
    skos:prefLabel "Life safety code"@en-US ;
    skos:definition "A set of rules for exits, fire separation and alarms that protect occupants during a fire or other emergency."@en ;
    skos:scopeNote "US: NFPA 101, required for healthcare facilities and by some states"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-nfpa ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00312 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00286 ;
    skos:notation "aeco-00312" ;
    skos:prefLabel "Energy code"@en-US ;
    skos:altLabel "energy conservation code"@en-US ;
    skos:definition "A set of minimum rules for the thermal envelope, heating, cooling, lighting and hot water of a facility, to limit power and fuel use."@en ;
    skos:scopeNote "US: the IECC or ASHRAE 90.1. UK: Approved Document L"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00313 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00286 ;
    skos:notation "aeco-00313" ;
    skos:prefLabel "Mechanical code"@en-US ;
    skos:definition "A set of rules for the design and installation of heating, ventilation, air conditioning and exhaust systems."@en ;
    skos:scopeNote "US: the IMC, or the UMC in some western states"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00314 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00286 ;
    skos:notation "aeco-00314" ;
    skos:prefLabel "Plumbing code"@en-US ;
    skos:definition "A set of rules for water supply, drainage, venting and fixtures that protects public health."@en ;
    skos:scopeNote "US: the IPC, or the UPC in some states"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00315 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00286 ;
    skos:notation "aeco-00315" ;
    skos:prefLabel "Electrical code"@en-US , "Wiring regulations"@en-GB ;
    skos:definition "A set of rules for the safe installation of wiring and power equipment, and for protection against shock and fire."@en ;
    skos:scopeNote "US: NFPA 70. UK: BS 7671"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00316 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00286 ;
    skos:notation "aeco-00316" ;
    skos:prefLabel "Local amendment"@en-US ;
    skos:altLabel "code amendment"@en-US ,
        "local modification"@en-US ;
    skos:definition "A change that a state or city makes to a model code when it adopts the code into law."@en ;
    skos:scopeNote "The project records which amendments apply (context schema 4.3)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00287 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00010 ;
    skos:notation "aeco-00287" ;
    skos:prefLabel "Referenced standards"@en-US , "Referenced standards"@en-GB ;
    skos:altLabel "code-referenced standards"@en-US ,
        "technical standards"@en-US ;
    skos:definition "Technical documents that a code names and makes part of its rules, for example a document for loads or for one material."@en ;
    skos:scopeNote "Issued by bodies such as ASCE, ACI, AISC, NFPA, ASTM and ICC. Names only, no text"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00317 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00287 ;
    skos:notation "aeco-00317" ;
    skos:prefLabel "Design load standard"@en-US ;
    skos:altLabel "minimum design loads"@en-US ,
        "structural loads standard"@en-US ;
    skos:definition "A document that gives the minimum forces from gravity, wind, snow, earthquake and flood that a structure must resist."@en ;
    skos:scopeNote "US: ASCE 7. UK: the Eurocodes"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00318 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00287 ;
    skos:notation "aeco-00318" ;
    skos:prefLabel "Structural material standard"@en-US ;
    skos:altLabel "material design standard"@en-US ;
    skos:definition "A document that sets design and detailing rules for one kind of load-bearing construction, such as concrete, steel, wood or masonry."@en ;
    skos:scopeNote "US: ACI 318, AISC 360, NDS, TMS 402"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00319 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00287 ;
    skos:notation "aeco-00319" ;
    skos:prefLabel "Fire protection system standard"@en-US ;
    skos:altLabel "fire alarm standard"@en-US ,
        "sprinkler standard"@en-US ;
    skos:definition "A document that sets rules for the design, installation and testing of sprinklers, alarms, standpipes and smoke control."@en ;
    skos:scopeNote "US: NFPA 13, NFPA 72, NFPA 14"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-nfpa ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00320 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00287 ;
    skos:notation "aeco-00320" ;
    skos:prefLabel "Accessibility standard"@en-US , "Accessibility standard"@en-GB ;
    skos:altLabel "ADA standards"@en-US ,
        "accessible design standard"@en-US ;
    skos:definition "A document that sets technical rules for routes, doors, toilets, signs and other parts so that people with disabilities can use a facility."@en ;
    skos:scopeNote "US: the 2010 ADA Standards and ICC A117.1. UK: Approved Document M and BS 8300"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00321 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00287 ;
    skos:notation "aeco-00321" ;
    skos:prefLabel "Test method standard"@en-US , "Test method standard"@en-GB ;
    skos:altLabel "test method"@en-US ,
        "testing standard"@en-US ;
    skos:definition "A document that sets how to sample and check a material or product, so that results from different laboratories agree."@en ;
    skos:scopeNote "US: ASTM methods, cited in codes and specifications"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00968 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00287 ;
    skos:notation "aeco-00968" ;
    skos:prefLabel "Ventilation standard"@en-US , "Ventilation standard"@en-GB ;
    skos:altLabel "indoor air quality standard"@en-US ,
        "ventilation code"@en-US ;
    skos:definition "A published document that sets minimum outdoor air rates and air quality controls for spaces by occupancy and use."@en ;
    skos:scopeNote "Examples: ASHRAE 62.1 for most buildings, ASHRAE 170 for healthcare. The Mechanical code (aeco-00313) adopts them"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00969 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00287 ;
    skos:notation "aeco-00969" ;
    skos:prefLabel "Facility design guideline"@en-US , "Facility design guideline"@en-GB ;
    skos:altLabel "facility type guideline"@en-US ,
        "sector design guide"@en-US ;
    skos:definition "A published guide that sets planning and construction requirements for one building type, such as hospitals, laboratories or data centers."@en ;
    skos:scopeNote "Examples: FGI Guidelines for healthcare, TIA-942 for data centers, BMBL for biosafety labs. Some states adopt them as code"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00288 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00010 ;
    skos:notation "aeco-00288" ;
    skos:prefLabel "Zoning and land use"@en-US , "Planning and land use"@en-GB ;
    skos:altLabel "land use regulations"@en-US ,
        "planning controls"@en-GB ;
    skos:definition "The local rules that control the use and development of property, and the approvals that allow a change."@en ;
    skos:scopeNote "Zoning, entitlements and variances. The authority is Planning authority (aeco-00118)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00322 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00288 ;
    skos:notation "aeco-00322" ;
    skos:prefLabel "Zoning ordinance"@en-US ;
    skos:altLabel "zoning bylaw"@en-US ,
        "zoning code"@en-US ,
        "zoning regulations"@en-US ;
    skos:definition "A local law that divides land into districts and sets the allowed uses, size, height and placement of buildings in each district."@en ;
    skos:scopeNote "Setbacks, height limits and parking rules come from here. UK: the local plan and planning policy"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00323 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00288 ;
    skos:notation "aeco-00323" ;
    skos:prefLabel "Land use entitlement"@en-US , "Planning permission"@en-GB ;
    skos:altLabel "development approval"@en-US ,
        "entitlements"@en-US ,
        "zoning approval"@en-US ,
        "planning approval"@en-GB ,
        "planning consent"@en-GB ;
    skos:definition "The legal right from a local authority to develop a parcel for a given use, size and layout."@en ;
    skos:scopeNote "Includes rezoning and planned development approval. Comes before the Building permit"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00324 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00288 ;
    skos:notation "aeco-00324" ;
    skos:prefLabel "Variance"@en-US ;
    skos:altLabel "zoning variance"@en-US ;
    skos:definition "Permission from an authority to depart from a zoning rule, such as a setback, because of a hardship that is specific to the site."@en ;
    skos:scopeNote "A departure from a building code rule is a Code modification. Not the UK variation, which is a contract change"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00325 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00288 ;
    skos:notation "aeco-00325" ;
    skos:prefLabel "Conditional use permit"@en-US ;
    skos:altLabel "special exception"@en-US ,
        "special use permit"@en-US ;
    skos:definition "Permission for an activity on a parcel that the zoning ordinance allows only after a public review and with conditions."@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00326 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00288 ;
    skos:notation "aeco-00326" ;
    skos:prefLabel "Subdivision approval"@en-US ;
    skos:altLabel "land division approval"@en-US ,
        "plat approval"@en-US ;
    skos:definition "The consent of a local authority to divide one parcel of land into two or more lots."@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00327 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00288 ;
    skos:notation "aeco-00327" ;
    skos:prefLabel "Site plan approval"@en-US ;
    skos:altLabel "site plan review"@en-US ;
    skos:definition "The consent of a local authority to the layout of buildings, access, parking, landscape and drainage on a parcel."@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00328 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00288 ;
    skos:notation "aeco-00328" ;
    skos:prefLabel "Impact fee"@en-US ;
    skos:altLabel "capacity fee"@en-US ,
        "development fee"@en-US ;
    skos:definition "A charge that a local authority collects from a developer to pay for public roads, schools, parks or utilities that new development needs."@en ;
    skos:scopeNote "UK: Community Infrastructure Levy and section 106 agreements"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00289 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00010 ;
    skos:notation "aeco-00289" ;
    skos:prefLabel "Permits and certificates"@en-US , "Permits and certificates"@en-GB ;
    skos:altLabel "permits"@en-US ,
        "regulatory approvals"@en-US ;
    skos:definition "The written approvals that an authority gives before work starts, during the work and before people occupy a facility."@en ;
    skos:scopeNote "The process to get one is Permit application (aeco-00204). The time window is the Permitting (aeco-00024) phase"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00329 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00289 ;
    skos:notation "aeco-00329" ;
    skos:prefLabel "Building permit"@en-US , "Building control approval"@en-GB ;
    skos:altLabel "building approval"@en-US ,
        "construction permit"@en-US ,
        "building regulations approval"@en-GB ;
    skos:definition "The written approval from the local authority to build or alter a structure according to the approved documents."@en ;
    skos:scopeNote "Issued by the Building official (aeco-00115). The process is Permit application (aeco-00204)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00330 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00289 ;
    skos:notation "aeco-00330" ;
    skos:prefLabel "Partial permit"@en-US ;
    skos:altLabel "early start permit"@en-US ,
        "foundation permit"@en-US ,
        "phased permit"@en-US ;
    skos:definition "An approval for one part of the work, such as foundations or the frame, that an authority issues before the full approval."@en ;
    skos:scopeNote "Common on fast-track and design-build projects"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00331 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00289 ;
    skos:notation "aeco-00331" ;
    skos:prefLabel "Demolition permit"@en-US ;
    skos:altLabel "demo permit"@en-US ;
    skos:definition "The approval from an authority to take down all or part of a structure and clear the site."@en ;
    skos:scopeNote "UK: demolition notice"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00332 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00289 ;
    skos:notation "aeco-00332" ;
    skos:prefLabel "Grading permit"@en-US ;
    skos:altLabel "earthwork permit"@en-US ,
        "site development permit"@en-US ;
    skos:definition "The approval from an authority to excavate, fill or change the shape of the ground on a site."@en ;
    skos:scopeNote "Often includes erosion and sediment control"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00333 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00289 ;
    skos:notation "aeco-00333" ;
    skos:prefLabel "Trade permit"@en-US ;
    skos:altLabel "electrical permit"@en-US ,
        "fire alarm permit"@en-US ,
        "mechanical permit"@en-US ,
        "plumbing permit"@en-US ,
        "sprinkler permit"@en-US ;
    skos:definition "An approval for the electrical, plumbing, mechanical or fire protection work of one licensed contractor."@en ;
    skos:scopeNote "Usually issued to the licensed trade contractor, not to the general contractor"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00334 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00289 ;
    skos:notation "aeco-00334" ;
    skos:prefLabel "Right-of-way permit"@en-US ;
    skos:altLabel "encroachment permit"@en-US ,
        "street opening permit"@en-US ,
        "street use permit"@en-US ;
    skos:definition "An approval from a public works authority to use or work in a public street, sidewalk or utility corridor."@en ;
    skos:scopeNote "For cranes, hoardings, lane closures and utility connections. UK: highway licences"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00335 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00289 ;
    skos:notation "aeco-00335" ;
    skos:prefLabel "Certificate of occupancy"@en-US ;
    skos:altLabel "C of O"@en-US ,
        "occupancy permit"@en-US ,
        "use and occupancy certificate"@en-US ;
    skos:hiddenLabel "CO"@en-US ;
    skos:definition "A document from the building authority that states that a facility meets the code and that people may use it."@en ;
    skos:scopeNote "Needed before Turnover (aeco-00043). Often tied to Substantial completion (aeco-00048). UK: the building control completion certificate"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00336 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00289 ;
    skos:notation "aeco-00336" ;
    skos:prefLabel "Temporary certificate of occupancy"@en-US ;
    skos:altLabel "TCO"@en-US ,
        "partial occupancy permit"@en-US ,
        "temporary C of O"@en-US ;
    skos:definition "A document from the building authority that lets people use all or part of a facility for a set time before completion."@en ;
    skos:scopeNote "Usually with a list of open items and an end date"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00337 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00289 ;
    skos:notation "aeco-00337" ;
    skos:prefLabel "Certificate of completion"@en-US ;
    skos:altLabel "permit closeout"@en-US ,
        "permit final"@en-US ;
    skos:definition "A document from the building authority that closes a permit when the work does not create a new occupancy, such as a shell."@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00290 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00010 ;
    skos:notation "aeco-00290" ;
    skos:prefLabel "Regulatory inspections"@en-US , "Regulatory inspections"@en-GB ;
    skos:altLabel "authority inspections"@en-US ,
        "required inspections"@en-US ;
    skos:definition "The checks that an authority or its agent makes on site to confirm that the work follows the code and the permit."@en ;
    skos:scopeNote "The result is an Inspection report (aeco-00262). The contractor's own check is Safety inspection (aeco-00220) or quality control"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00338 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00290 ;
    skos:notation "aeco-00338" ;
    skos:prefLabel "Code inspection"@en-US , "Building control inspection"@en-GB ;
    skos:altLabel "building inspection"@en-US ,
        "municipal inspection"@en-US ,
        "permit inspection"@en-US ;
    skos:definition "A visit by the building official at a set stage of the work to confirm that it follows the permit and the approved documents."@en ;
    skos:scopeNote "Stages such as footing, framing, rough-in, insulation and final. The role is Building official (aeco-00115)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00339 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00290 ;
    skos:notation "aeco-00339" ;
    skos:prefLabel "Special inspection"@en-US ;
    skos:altLabel "structural special inspection"@en-US ;
    skos:definition "A check by a qualified agent that the owner hires, of work that the code lists as critical, such as welding, bolting and structural concrete."@en ;
    skos:scopeNote "IBC chapter 17. The role is Special inspector (aeco-00117). The tests are done by a Testing agency (aeco-00123)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-icc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00340 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00290 ;
    skos:notation "aeco-00340" ;
    skos:prefLabel "Fire inspection"@en-US ;
    skos:altLabel "fire department inspection"@en-US ,
        "fire marshal inspection"@en-US ;
    skos:definition "A check by the fire marshal's office of sprinklers, alarms, exits and emergency access, before and after occupancy."@en ;
    skos:scopeNote "Includes acceptance tests of sprinklers and alarms. The role is Fire marshal (aeco-00116)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00341 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00290 ;
    skos:notation "aeco-00341" ;
    skos:prefLabel "Occupational safety inspection"@en-US ;
    skos:altLabel "OSHA inspection"@en-US ,
        "OSHA visit"@en-US ;
    skos:definition "A visit by a government officer to a site to check that the employers follow the rules that protect workers."@en ;
    skos:scopeNote "Can lead to citations and fines. The contractor's own check is Safety inspection (aeco-00220)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00291 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00010 ;
    skos:notation "aeco-00291" ;
    skos:prefLabel "Code compliance methods"@en-US , "Code compliance methods"@en-GB ;
    skos:altLabel "compliance approaches"@en-US ,
        "compliance paths"@en-US ;
    skos:definition "The ways that a design team can show an authority that a design meets the rules."@en ;
    skos:scopeNote "The check itself is Code compliance review (aeco-00203)"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00342 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00291 ;
    skos:notation "aeco-00342" ;
    skos:prefLabel "Prescriptive compliance"@en-US , "Prescriptive compliance"@en-GB ;
    skos:altLabel "prescriptive method"@en-US ,
        "prescriptive path"@en-US ,
        "deemed-to-satisfy"@en-GB ;
    skos:definition "A way to meet a code by following its fixed rules, such as set sizes, ratings and limits, with no further analysis."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00343 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00291 ;
    skos:notation "aeco-00343" ;
    skos:prefLabel "Performance-based design"@en-US , "Performance-based design"@en-GB ;
    skos:altLabel "engineered solution"@en-US ,
        "performance path"@en-US ,
        "performance-based approach"@en-US ,
        "fire engineered solution"@en-GB ;
    skos:definition "A way to meet a code by proving with analysis that a solution reaches the code's safety goals, instead of following its fixed rules."@en ;
    skos:scopeNote "Common for fire, smoke and seismic design. Needs the authority's approval"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00344 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00291 ;
    skos:notation "aeco-00344" ;
    skos:prefLabel "Alternative materials and methods"@en-US ;
    skos:altLabel "AMMR"@en-US ,
        "alternate materials and methods"@en-US ,
        "alternative design request"@en-US ;
    skos:definition "A request to use a material, design or method that the code does not name, with proof that it is at least equivalent."@en ;
    skos:scopeNote "IBC section 104. Not the contractor's means and methods"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-why ;
    aeco:appliesUnder aeco:std-icc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00345 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00291 ;
    skos:notation "aeco-00345" ;
    skos:prefLabel "Code modification"@en-US ;
    skos:altLabel "code relief"@en-US ,
        "modification request"@en-US ,
        "dispensation"@en-GB ,
        "relaxation"@en-GB ;
    skos:definition "Permission from the building official to relax one rule on one project, when strict compliance is not practical and the intent is still met."@en ;
    skos:scopeNote "A departure from a zoning rule is a Variance"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00346 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00291 ;
    skos:notation "aeco-00346" ;
    skos:prefLabel "Code interpretation"@en-US ;
    skos:altLabel "code ruling"@en-US ,
        "formal interpretation"@en-US ,
        "determination"@en-GB ;
    skos:definition "A written answer from the building official or the issuing body on how one rule applies to a given case."@en ;
    skos:scopeNote "Useful as a precedent on later projects in the same jurisdiction"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00292 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00010 ;
    skos:notation "aeco-00292" ;
    skos:prefLabel "Occupational safety regulations"@en-US ;
    skos:altLabel "OSHA standards"@en-US ,
        "worker safety regulations"@en-US ;
    skos:definition "The rules that an authority makes to protect workers from injury and illness on construction sites."@en ;
    skos:scopeNote "US federal rules in 29 CFR 1926, with state plans where they apply. UK health and safety law is not covered yet. The hazards are in Events and risks"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-where ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00347 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00292 ;
    skos:notation "aeco-00347" ;
    skos:prefLabel "Fall protection rule"@en-US ;
    skos:altLabel "fall protection standard"@en-US ;
    skos:definition "The requirements for guardrails, safety nets, personal fall arrest systems and training when people work at height."@en ;
    skos:scopeNote "29 CFR 1926 Subpart M. The hazard is Fall hazard (aeco-00062)"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-where ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00348 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00292 ;
    skos:notation "aeco-00348" ;
    skos:prefLabel "Scaffold rule"@en-US ;
    skos:altLabel "scaffolding standard"@en-US ;
    skos:definition "The requirements for design, erection, inspection and use of temporary elevated work platforms, with a competent person check before each shift."@en ;
    skos:scopeNote "29 CFR 1926 Subpart L"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-where ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00349 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00292 ;
    skos:notation "aeco-00349" ;
    skos:prefLabel "Excavation rule"@en-US ;
    skos:altLabel "excavation standard"@en-US ,
        "trenching standard"@en-US ;
    skos:definition "The requirements for sloping, shoring and shielding trenches and other cuts in the ground, and for daily checks by a competent person."@en ;
    skos:scopeNote "29 CFR 1926 Subpart P"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-where ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00350 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00292 ;
    skos:notation "aeco-00350" ;
    skos:prefLabel "Crane and rigging rule"@en-US ;
    skos:altLabel "cranes and derricks standard"@en-US ;
    skos:definition "The requirements for assembly, inspection and operation of lifting machines, for operator certification, and for riggers and signal persons."@en ;
    skos:scopeNote "29 CFR 1926 Subpart CC"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-where ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00351 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00292 ;
    skos:notation "aeco-00351" ;
    skos:prefLabel "Electrical safety rule"@en-US ;
    skos:definition "The requirements that protect workers from shock and arc flash, such as ground-fault protection, lockout and safe clearances from power lines."@en ;
    skos:scopeNote "29 CFR 1926 Subpart K. The hazard is Electrical hazard (aeco-00065)"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-where ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00352 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00292 ;
    skos:notation "aeco-00352" ;
    skos:prefLabel "Hazard communication rule"@en-US ;
    skos:altLabel "HazCom"@en-US ,
        "right-to-know rule"@en-US ;
    skos:definition "The requirements to label chemicals, keep safety data sheets and train workers on the chemical dangers at the workplace."@en ;
    skos:scopeNote "29 CFR 1926.59"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-where ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00353 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00292 ;
    skos:notation "aeco-00353" ;
    skos:prefLabel "Silica exposure rule"@en-US ;
    skos:altLabel "silica standard"@en-US ;
    skos:definition "The requirements to limit the respirable crystalline silica dust that workers breathe when they cut, drill or grind concrete, stone or masonry."@en ;
    skos:scopeNote "29 CFR 1926.1153. Needs an exposure control plan"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-where ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00354 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00292 ;
    skos:notation "aeco-00354" ;
    skos:prefLabel "Confined space rule"@en-US ;
    skos:altLabel "permit-required confined space rule"@en-US ;
    skos:definition "The requirements to assess, permit and control entry into enclosed areas with limited openings and possible hazardous air, such as vaults, pits and tanks."@en ;
    skos:scopeNote "29 CFR 1926 Subpart AA"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-where ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00293 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00010 ;
    skos:notation "aeco-00293" ;
    skos:prefLabel "Environmental regulations"@en-US , "Environmental regulations"@en-GB ;
    skos:altLabel "environmental compliance"@en-US ,
        "environmental rules"@en-US ;
    skos:definition "The rules that an authority makes to protect air, water, land, wildlife and heritage from harm that building work can cause."@en ;
    skos:scopeNote "Site facts such as wetlands and habitats are in Site and environment. The contractor's process is Environmental management (aeco-00222)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00355 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00293 ;
    skos:notation "aeco-00355" ;
    skos:prefLabel "Environmental review"@en-US , "Environmental impact assessment"@en-GB ;
    skos:altLabel "CEQA review"@en-US ,
        "NEPA review"@en-US ,
        "environmental impact study"@en-US ,
        "EIA"@en-GB ;
    skos:definition "A study, before approval, of the effects that a project can have on air, water, land, wildlife, traffic and communities."@en ;
    skos:scopeNote "US: NEPA for federal actions and state laws such as CEQA. UK: EIA regulations"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00356 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00293 ;
    skos:notation "aeco-00356" ;
    skos:prefLabel "Stormwater permit"@en-US ;
    skos:altLabel "NPDES permit"@en-US ,
        "construction general permit"@en-US ,
        "erosion control permit"@en-US ;
    skos:definition "An approval that sets how a site controls rain runoff, erosion and sediment during construction."@en ;
    skos:scopeNote "Needs a stormwater pollution prevention plan (SWPPP). US federal or state program"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00357 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00293 ;
    skos:notation "aeco-00357" ;
    skos:prefLabel "Wetland permit"@en-US ;
    skos:altLabel "Section 404 permit"@en-US ,
        "dredge and fill permit"@en-US ;
    skos:definition "An approval to fill, dredge or build in a wetland or other protected water body, often with a duty to replace the lost area."@en ;
    skos:scopeNote "US: Clean Water Act section 404. The site feature is Wetland"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00358 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00293 ;
    skos:notation "aeco-00358" ;
    skos:prefLabel "Air quality permit"@en-US ;
    skos:altLabel "air permit"@en-US ,
        "dust control permit"@en-US ;
    skos:definition "An approval that limits dust and exhaust from a site or from equipment such as generators and concrete plants."@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00359 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00293 ;
    skos:notation "aeco-00359" ;
    skos:prefLabel "Hazardous building material rule"@en-US ;
    skos:altLabel "abatement rules"@en-US ,
        "asbestos regulations"@en-US ,
        "lead paint rule"@en-US ;
    skos:definition "The requirements to survey, remove and dispose of asbestos, lead paint and other dangerous substances before renovation or demolition."@en ;
    skos:scopeNote "US: EPA rules for asbestos and lead, plus OSHA. The site fact is Hazardous building material"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00360 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00293 ;
    skos:notation "aeco-00360" ;
    skos:prefLabel "Historic preservation review"@en-US ;
    skos:altLabel "Section 106 review"@en-US ,
        "heritage review"@en-US ,
        "landmarks review"@en-US ,
        "heritage impact assessment"@en-GB ;
    skos:definition "A check of how a project affects buildings, districts and archaeological sites of heritage value, with steps to avoid or reduce harm."@en ;
    skos:scopeNote "US: Section 106 for federal actions and local landmark commissions. UK: listed building consent. The site fact is Historic resource"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00361 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00293 ;
    skos:notation "aeco-00361" ;
    skos:prefLabel "Protected species review"@en-US ;
    skos:altLabel "endangered species review"@en-US ,
        "habitat assessment"@en-US ,
        "protected species survey"@en-GB ;
    skos:definition "A check of whether work can harm plants or animals that the law protects, and of the steps to avoid harm."@en ;
    skos:scopeNote "US: the Endangered Species Act. The site fact is Protected habitat"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00294 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00010 ;
    skos:notation "aeco-00294" ;
    skos:prefLabel "Labor and local rules"@en-US , "Labour and local rules"@en-GB ;
    skos:altLabel "labor rules"@en-US ,
        "local ordinances"@en-US ;
    skos:definition "The requirements on who may do the work, how workers are paid, and when the work may happen."@en ;
    skos:scopeNote "Prevailing wage, licenses, work hours and noise (context schema 4.3)"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00362 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00294 ;
    skos:notation "aeco-00362" ;
    skos:prefLabel "Prevailing wage requirement"@en-US ;
    skos:altLabel "Davis-Bacon wages"@en-US ,
        "prevailing wage law"@en-US ;
    skos:definition "A rule that public projects must pay workers at least the local pay rates that the government publishes for each trade."@en ;
    skos:scopeNote "US: the Davis-Bacon Act and state laws. Needs certified payroll reports"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00363 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00294 ;
    skos:notation "aeco-00363" ;
    skos:prefLabel "Contractor license"@en-US ;
    skos:altLabel "contractor licensing"@en-US ,
        "trade license"@en-US ;
    skos:definition "The permission from a state or local board that lets a company or person do construction work of a given type and value."@en ;
    skos:scopeNote "Per state, often with classes and limits. Trade permits go to licensed contractors"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00364 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00294 ;
    skos:notation "aeco-00364" ;
    skos:prefLabel "Professional license"@en-US , "Professional registration"@en-GB ;
    skos:altLabel "PE license"@en-US ,
        "architectural license"@en-US ,
        "professional seal"@en-US ;
    skos:definition "The permission from a state board that lets an architect or engineer practice and seal design documents."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00365 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00294 ;
    skos:notation "aeco-00365" ;
    skos:prefLabel "Noise and work hours ordinance"@en-US ;
    skos:altLabel "construction hours ordinance"@en-US ,
        "noise limits"@en-US ,
        "work hours limit"@en-US ;
    skos:definition "A local law that limits sound levels and the times and days when construction may happen."@en ;
    skos:scopeNote "From the context schema: local ordinances on work hours and noise"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00366 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00294 ;
    skos:notation "aeco-00366" ;
    skos:prefLabel "Business participation goal"@en-US ;
    skos:altLabel "DBE goal"@en-US ,
        "MWBE goal"@en-US ,
        "supplier diversity requirement"@en-US ;
    skos:definition "A target on public projects for the share of work that goes to small, minority-owned, women-owned or disadvantaged firms."@en ;
    skos:scopeNote "US federal and state programs. Needs good-faith effort records"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00367 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00294 ;
    skos:notation "aeco-00367" ;
    skos:prefLabel "Domestic content requirement"@en-US ;
    skos:altLabel "Buy America"@en-US ,
        "Buy American"@en-US ,
        "domestic preference"@en-US ;
    skos:definition "A rule that public projects use iron, steel, manufactured products or materials made in the country."@en ;
    skos:scopeNote "US: Buy America and Buy American rules for federal funds"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
