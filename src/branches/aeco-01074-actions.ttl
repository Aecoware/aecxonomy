aeco:aeco-01109 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-01078 ;
    skos:notation "aeco-01109" ;
    skos:prefLabel "Record"@en-US , "Record"@en-GB ;
    skos:altLabel "log"@en-US ,
        "note"@en-US ;
    skos:definition "To write down a fact, a result or an event so that other people can find it later."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-11-23"^^xsd:date ;
    dct:modified "2026-11-23"^^xsd:date .

aeco:aeco-01079 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-01074 ;
    skos:notation "aeco-01079" ;
    skos:prefLabel "Status actions"@en-US , "Status actions"@en-GB ;
    skos:definition "An action that changes the state of an item, such as who owns it or whether it is open or closed."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-11-23"^^xsd:date ;
    dct:modified "2026-11-23"^^xsd:date .

aeco:aeco-01110 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-01079 ;
    skos:notation "aeco-01110" ;
    skos:prefLabel "Open"@en-US , "Open"@en-GB ;
    skos:altLabel "activate"@en-US ;
    skos:definition "To make an item active, so that work and replies on it can start."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-11-23"^^xsd:date ;
    dct:modified "2026-11-23"^^xsd:date .

aeco:aeco-01111 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-01079 ;
    skos:notation "aeco-01111" ;
    skos:prefLabel "Assign"@en-US , "Assign"@en-GB ;
    skos:altLabel "allocate"@en-US ;
    skos:definition "To give an item to a person or a party, who then must act on it."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-11-23"^^xsd:date ;
    dct:modified "2026-11-23"^^xsd:date .

aeco:aeco-01112 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-01079 ;
    skos:notation "aeco-01112" ;
    skos:prefLabel "Escalate"@en-US , "Escalate"@en-GB ;
    skos:definition "To pass an item to a higher level of authority because it is late, disputed or high in risk."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-11-23"^^xsd:date ;
    dct:modified "2026-11-23"^^xsd:date .

aeco:aeco-01113 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-01079 ;
    skos:notation "aeco-01113" ;
    skos:prefLabel "Close"@en-US , "Close"@en-GB ;
    skos:altLabel "resolve"@en-US ;
    skos:definition "To mark an item as finished after its reply is accepted and any follow-up is recorded."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-11-23"^^xsd:date ;
    dct:modified "2026-11-23"^^xsd:date .

aeco:aeco-01114 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-01079 ;
    skos:notation "aeco-01114" ;
    skos:prefLabel "Reopen"@en-US , "Reopen"@en-GB ;
    skos:definition "To make a closed item active again, because it needs more work or a new reply."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-11-23"^^xsd:date ;
    dct:modified "2026-11-23"^^xsd:date .

aeco:aeco-01115 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-01079 ;
    skos:notation "aeco-01115" ;
    skos:prefLabel "Void"@en-US , "Void"@en-GB ;
    skos:altLabel "invalidate"@en-US ;
    skos:definition "To mark an item as not valid, while it stays in the record."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-11-23"^^xsd:date ;
    dct:modified "2026-11-23"^^xsd:date .

aeco:aeco-01116 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-01079 ;
    skos:notation "aeco-01116" ;
    skos:prefLabel "Cancel"@en-US , "Cancel"@en-GB ;
    skos:altLabel "withdraw"@en-US ;
    skos:definition "To stop an item or a piece of work before it is complete, so that it needs no more action."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-11-23"^^xsd:date ;
