aeco:aeco-01074 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-01074" ;
    skos:prefLabel "Actions"@en-US , "Actions"@en-GB ;
    skos:altLabel "action types"@en-US ,
        "verbs"@en-US ;
    skos:definition "A kind of step that a person or an agent takes in the work, named by a verb. Examples are submit, approve and close."@en ;
    skos:scopeNote "An action combines with the thing it acts on, from another branch: Approve + Change order. A ledger record of work names one action and one thing. An activity concept such as Approve change order points to both"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Added" ;
    aeco:depthLimit 3 ;
    dct:created "2026-11-23"^^xsd:date ;
    dct:modified "2026-11-23"^^xsd:date .

