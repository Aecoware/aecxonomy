aeco:aeco-01009 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00590 ;
    skos:notation "aeco-01009" ;
    skos:prefLabel "Column"@en-US , "Column"@en-GB ;
    skos:altLabel "pillar"@en-US ,
