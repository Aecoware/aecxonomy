    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-01006 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00585 ;
    skos:notation "aeco-01006" ;
    skos:prefLabel "Drilled shaft"@en-US , "Bored pile"@en-GB ;
    skos:altLabel "CIDH pile"@en-US ,
        "bored pier"@en-US ,
        "caisson"@en-US ,
        "drilled pier"@en-US ;
    skos:definition "A large-diameter concrete pier cast in a bored hole that carries heavy column loads to deep soil or rock."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
