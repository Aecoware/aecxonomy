aeco:aeco-00003 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00003" ;
    skos:prefLabel "Elements and systems"@en-US , "Elements and systems"@en-GB ;
    skos:altLabel "building element"@en-US ,
        "building system"@en-US ,
        "construction element"@en-US ;
    skos:definition "A part of a built asset that people design and assemble from products to do a specific function. Examples are a foundation, an exterior wall, a roof and an HVAC system."@en ;
    skos:scopeNote "The function view: a part in its place in the asset and what it does, such as a foundation, an exterior wall, a door assembly or a cooling system. The same physical item, seen as something to specify and buy, is a product. Related links join the two views. UniFormat works this way"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Results" ;
    aeco:depthLimit 4 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00456 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00003 ;
    skos:notation "aeco-00456" ;
    skos:prefLabel "Substructure"@en-US , "Substructure"@en-GB ;
    skos:altLabel "below-grade construction"@en-US ,
        "foundation"@en-US ,
        "foundations"@en-US ,
        "foundations and basement"@en-US ;
    skos:definition "The parts of a building below the lowest floor that carry its loads to the ground and keep out water and soil."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00584 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00456 ;
    skos:notation "aeco-00584" ;
    skos:prefLabel "Shallow foundation"@en-US , "Shallow foundation"@en-GB ;
    skos:altLabel "footings"@en-US ,
        "spread foundation"@en-US ;
    skos:definition "A footing that spreads loads into soil near the surface, such as a spread footing, strip footing or mat."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-01001 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00584 ;
    skos:notation "aeco-01001" ;
    skos:prefLabel "Spread footing"@en-US , "Pad foundation"@en-GB ;
    skos:altLabel "column footing"@en-US ,
        "isolated footing"@en-US ,
        "pad footing"@en-US ;
    skos:definition "A concrete pad under a column or pier that distributes its load over a wider area of soil."@en ;
    skos:scopeNote "A footing under a wall is a Strip footing"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-01002 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00584 ;
    skos:notation "aeco-01002" ;
    skos:prefLabel "Strip footing"@en-US , "Strip foundation"@en-GB ;
    skos:altLabel "continuous footing"@en-US ,
        "wall footing"@en-US ;
    skos:definition "A long, narrow concrete base that runs under a wall and carries its load to the soil."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-01003 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00584 ;
    skos:notation "aeco-01003" ;
    skos:prefLabel "Mat foundation"@en-US , "Raft foundation"@en-GB ;
    skos:altLabel "mat slab"@en-US ,
        "raft"@en-US ;
    skos:definition "A thick reinforced concrete slab under all or most of a building that carries all column and wall loads to the soil."@en ;
    skos:scopeNote "Used where the soil is weak or the loads are high"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-01004 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00584 ;
    skos:notation "aeco-01004" ;
    skos:prefLabel "Grade beam"@en-US , "Ground beam"@en-GB ;
    skos:altLabel "footing beam"@en-US ;
    skos:definition "A reinforced concrete member at or just below ground level that carries a wall and ties footings or pile caps together."@en ;
    skos:scopeNote "Also spans between pile caps on a Deep foundation (aeco-00585)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00585 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00456 ;
    skos:notation "aeco-00585" ;
    skos:prefLabel "Deep foundation"@en-US , "Piled foundation"@en-GB ;
    skos:altLabel "pile foundation"@en-US ,
        "piled foundation"@en-US ;
    skos:definition "Piles, drilled shafts or caissons that carry loads down to deeper soil or rock."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-01005 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00585 ;
    skos:notation "aeco-01005" ;
    skos:prefLabel "Pile"@en-US , "Pile"@en-GB ;
    skos:altLabel "bearing pile"@en-US ,
        "driven pile"@en-US ,
        "foundation pile"@en-US ;
    skos:definition "A long, slender steel, concrete or timber member that a rig drives or drills into the ground to carry loads to deeper strata."@en ;
    skos:scopeNote "The work of installing it is Piling (aeco-00700)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
