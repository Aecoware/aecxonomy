aeco:aeco-01010 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00590 ;
    skos:notation "aeco-01010" ;
    skos:prefLabel "Load-bearing wall"@en-US , "Loadbearing wall"@en-GB ;
    skos:altLabel "bearing wall"@en-US ,
        "structural wall"@en-US ;
    skos:hiddenLabel "wall"@en-US ;
    skos:definition "A vertical element of masonry, concrete or framing that supports floors and roofs above, in addition to its own weight."@en ;
