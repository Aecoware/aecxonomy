aeco:aeco-00589 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00456 ;
    skos:notation "aeco-00589" ;
    skos:prefLabel "Soil gas mitigation"@en-US , "Ground gas protection"@en-GB ;
