    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-01007 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00585 ;
    skos:notation "aeco-01007" ;
    skos:prefLabel "Pile cap"@en-US , "Pile cap"@en-GB ;
    skos:definition "A thick concrete block that joins the heads of a group of piles and shares a column load among them."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
