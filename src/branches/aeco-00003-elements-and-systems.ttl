aeco:aeco-01063 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00585 ;
    skos:notation "aeco-01063" ;
    skos:prefLabel "Helical pile"@en-US , "Screw pile"@en-GB ;
    skos:altLabel "helical anchor"@en-US ,
