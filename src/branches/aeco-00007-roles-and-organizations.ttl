    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-01037 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00074 ;
    skos:notation "aeco-01037" ;
    skos:prefLabel "Contracting officer"@en-US , "Contracting officer"@en-GB ;
    skos:altLabel "government contracting officer"@en-US ;
    skos:definition "The public official with the authority to award, change and end a government contract and to bind the agency."@en ;
    skos:scopeNote "US federal and many state contracts. The contracting officer's representative acts on site with delegated, limited authority"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-01038 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00074 ;
    skos:notation "aeco-01038" ;
    skos:prefLabel "Resident engineer"@en-US , "Resident engineer"@en-GB ;
    skos:altLabel "owner's field engineer"@en-US ,
        "resident project representative"@en-US ;
    skos:hiddenLabel "RPR"@en-US ;
    skos:definition "The owner's technical lead who stays on site to administer the contract, check the work and keep the project records."@en ;
    skos:scopeNote "Common on public works and transportation projects"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-01039 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00074 ;
    skos:notation "aeco-01039" ;
    skos:prefLabel "Project inspector"@en-US , "Site inspector"@en-GB ;
    skos:altLabel "field inspector"@en-US ,
        "inspector of record"@en-US ,
        "owner's inspector"@en-US ;
    skos:hiddenLabel "IOR"@en-US ;
    skos:definition "A person whom the owner or the authority places on site to watch the work and report whether it follows the approved documents."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00075 a skos:Concept ;
