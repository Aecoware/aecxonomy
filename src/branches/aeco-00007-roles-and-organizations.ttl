    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00079 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00007 ;
    skos:notation "aeco-00079" ;
    skos:prefLabel "Advisors and verifiers"@en-US , "Advisors and verifiers"@en-GB ;
    skos:altLabel "independent consultants"@en-US ,
        "third parties"@en-US ;
    skos:definition "The independent specialists that advise a party or check that work meets the requirements."@en ;
    skos:scopeNote "Commissioning, cost, code, survey, testing, third-party inspection"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00119 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00079 ;
    skos:notation "aeco-00119" ;
    skos:prefLabel "Commissioning agent"@en-US , "Commissioning manager"@en-GB ;
    skos:altLabel "CxA"@en-US ,
        "commissioning authority"@en-US ,
        "commissioning provider"@en-US ;
    skos:definition "An independent specialist who checks that building systems are designed, installed and work as the owner requires."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00120 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00079 ;
    skos:notation "aeco-00120" ;
    skos:prefLabel "Cost consultant"@en-US , "Quantity surveyor"@en-GB ;
    skos:altLabel "cost manager"@en-US ,
        "QS"@en-GB ;
    skos:definition "An independent specialist who estimates and controls project costs for the owner."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00121 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00079 ;
    skos:notation "aeco-00121" ;
    skos:prefLabel "Code consultant"@en-US ;
    skos:altLabel "code expert"@en-US ,
        "approved inspector"@en-GB ;
    skos:definition "A specialist who advises the design team on how to meet building, fire and accessibility codes."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00122 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00079 ;
    skos:notation "aeco-00122" ;
    skos:prefLabel "Land surveyor"@en-US , "Land surveyor"@en-GB ;
    skos:altLabel "PLS"@en-US ,
        "professional land surveyor"@en-US ,
        "surveyor"@en-US ;
    skos:definition "A licensed professional who measures land and marks boundaries, levels and the positions of structures."@en ;
