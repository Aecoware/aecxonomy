    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00114 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00078 ;
    skos:notation "aeco-00114" ;
    skos:prefLabel "Authority having jurisdiction"@en-US ;
    skos:altLabel "AHJ"@en-US ;
    skos:definition "The public body or official that enforces a code or standard and approves the work under it."@en ;
    skos:scopeNote "UK equivalents are split across building control, fire and planning"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who , aeco:tag-where ;
    aeco:appliesUnder aeco:std-icc , aeco:std-nfpa ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00115 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00078 ;
    skos:notation "aeco-00115" ;
    skos:prefLabel "Building official"@en-US , "Building control officer"@en-GB ;
    skos:altLabel "building inspector"@en-US ,
        "code official"@en-US ,
        "building control surveyor"@en-GB ;
    skos:definition "The public officer who reviews permit documents and inspects construction for code compliance."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who , aeco:tag-where ;
    aeco:appliesUnder aeco:std-icc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00116 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00078 ;
    skos:notation "aeco-00116" ;
    skos:prefLabel "Fire marshal"@en-US ;
    skos:altLabel "fire code official"@en-US ,
        "fire official"@en-US ;
    skos:definition "The public official who enforces fire codes and approves fire protection and life safety systems."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who , aeco:tag-where ;
    aeco:appliesUnder aeco:std-icc , aeco:std-nfpa ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00117 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00078 ;
    skos:notation "aeco-00117" ;
    skos:prefLabel "Special inspector"@en-US ;
    skos:definition "A qualified person that the owner hires and the authority approves to check critical work, such as structural welds."@en ;
    skos:scopeNote "IBC chapter 17 special inspections"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who , aeco:tag-where ;
    aeco:appliesUnder aeco:std-icc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00118 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00078 ;
    skos:notation "aeco-00118" ;
    skos:prefLabel "Planning authority"@en-US , "Local planning authority"@en-GB ;
    skos:altLabel "planning commission"@en-US ,
        "planning department"@en-US ,
        "zoning board"@en-US ,
        "LPA"@en-GB ;
    skos:definition "The public body that controls land use and zoning, and approves site plans and changes of use."@en ;
