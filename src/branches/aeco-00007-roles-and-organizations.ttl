aeco:aeco-00124 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00079 ;
    skos:notation "aeco-00124" ;
    skos:prefLabel "Third-party inspector"@en-US , "Independent inspector"@en-GB ;
    skos:altLabel "independent inspector"@en-US ,
        "clerk of works"@en-GB ;
    skos:definition "An independent firm that inspects work for an owner, lender or insurer and reports the results."@en ;
    aeco:primaryTag aeco:tag-who ;
