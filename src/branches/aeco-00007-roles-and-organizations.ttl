    skos:definition "The companies and professionals that plan the form and systems of a built asset, and sign the drawings and specifications."@en ;
    skos:scopeNote "Architect, engineers, landscape architect, specialty consultants"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00096 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00075 ;
    skos:notation "aeco-00096" ;
    skos:prefLabel "Architect"@en-US , "Architect"@en-GB ;
    skos:altLabel "architect of record"@en-US ,
        "registered architect"@en-US ;
    skos:definition "A licensed professional who designs buildings and leads the design team on most building projects."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00097 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00075 ;
    skos:notation "aeco-00097" ;
    skos:prefLabel "Structural engineer"@en-US , "Structural engineer"@en-GB ;
    skos:altLabel "SE"@en-US ,
        "structural engineer of record"@en-US ;
    skos:definition "A licensed design professional who designs the parts of a built asset that carry loads, such as foundations and frames."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00098 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00075 ;
    skos:notation "aeco-00098" ;
    skos:prefLabel "MEP engineer"@en-US , "Building services engineer"@en-GB ;
    skos:altLabel "mechanical, electrical and plumbing engineer"@en-US ,
        "M&E engineer"@en-GB ;
    skos:definition "A design professional who designs the mechanical, electrical and plumbing systems of a built asset."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00099 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00075 ;
    skos:notation "aeco-00099" ;
    skos:prefLabel "Civil engineer"@en-US , "Civil engineer"@en-GB ;
    skos:altLabel "civil engineer of record"@en-US ,
        "site engineer"@en-US ;
    skos:definition "A licensed design professional who designs the site work, roads, grading, drainage and utilities of a project."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
