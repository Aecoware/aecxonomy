aeco:aeco-00080 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00007 ;
    skos:notation "aeco-00080" ;
    skos:prefLabel "Software agents"@en-US , "Software agents"@en-GB ;
    skos:altLabel "agents"@en-US ,
        "digital agents"@en-US ;
    skos:definition "Programs that do tasks for a person or a company within the permissions that they get."@en ;
    skos:scopeNote "Agents are actors, as in the Aecoware glossary. Proposed so that agent roles can be routed and scoped like people"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00125 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00080 ;
    skos:notation "aeco-00125" ;
    skos:prefLabel "AI agent"@en-US , "AI agent"@en-GB ;
    skos:altLabel "AI assistant"@en-US ,
        "autonomous agent"@en-US ,
        "copilot"@en-US ;
    skos:definition "Software that uses an AI model to plan and do tasks for a person or a company within given permissions."@en ;
    skos:scopeNote "Agent Studio registers, scopes and logs these"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00126 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00080 ;
    skos:notation "aeco-00126" ;
    skos:prefLabel "Automation service"@en-US , "Automation service"@en-GB ;
    skos:altLabel "bot"@en-US ,
        "integration service"@en-US ,
        "workflow automation"@en-US ;
    skos:definition "Software that runs fixed rules to move or change data between systems without a person in the loop."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
