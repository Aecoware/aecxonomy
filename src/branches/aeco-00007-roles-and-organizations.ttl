aeco:aeco-00077 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00007 ;
    skos:notation "aeco-00077" ;
    skos:prefLabel "Project team positions"@en-US , "Project team positions"@en-GB ;
    skos:altLabel "job titles"@en-US ,
        "project roles"@en-US ;
    skos:definition "The jobs that people hold on a delivery team, with their typical duties. One person can hold more than one position."@en ;
    skos:scopeNote "Jobs held by people, not companies. The company a person works for is in the other groups"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00108 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00077 ;
    skos:notation "aeco-00108" ;
    skos:prefLabel "Project manager"@en-US , "Project manager"@en-GB ;
    skos:altLabel "PM"@en-US ;
    skos:definition "The person who is responsible for the scope, time, cost and quality of the work for one party."@en ;
    skos:scopeNote "Each party can have one: owner, designer, contractor"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00109 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00077 ;
    skos:notation "aeco-00109" ;
    skos:prefLabel "Project engineer"@en-US , "Project engineer"@en-GB ;
    skos:altLabel "field engineer"@en-US ;
    skos:definition "A team member who handles technical tasks for the contractor, such as RFIs, submittals and document control."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00110 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00077 ;
    skos:notation "aeco-00110" ;
    skos:prefLabel "Superintendent"@en-US , "Site manager"@en-GB ;
    skos:altLabel "site superintendent"@en-US ,
        "super"@en-US ,
        "site agent"@en-GB ;
    skos:definition "The person who directs the daily work on site for the contractor, including crews, schedule and safety."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00111 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00077 ;
    skos:notation "aeco-00111" ;
    skos:prefLabel "Foreman"@en-US , "Foreman"@en-GB ;
    skos:altLabel "crew leader"@en-US ,
        "foreperson"@en-US ,
        "ganger"@en-GB ;
    skos:definition "A person who leads one crew or trade on site and directs its daily tasks."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00112 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00077 ;
    skos:notation "aeco-00112" ;
    skos:prefLabel "Estimator"@en-US , "Estimator"@en-GB ;
    skos:altLabel "cost estimator"@en-US ;
    skos:definition "A person who calculates the expected cost of work from drawings, specifications and prices."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00113 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00077 ;
    skos:notation "aeco-00113" ;
    skos:prefLabel "Safety manager"@en-US , "Health and safety manager"@en-GB ;
    skos:altLabel "EHS manager"@en-US ,
        "safety officer"@en-US ;
    skos:definition "A person who plans and checks the measures that protect workers and the public from harm on a project."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-osha1926 , aeco:std-shared ;
