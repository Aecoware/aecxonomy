    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00102 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00076 ;
    skos:notation "aeco-00102" ;
    skos:prefLabel "General contractor"@en-US , "Main contractor"@en-GB ;
    skos:altLabel "GC"@en-US ,
        "contractor"@en-US ,
        "prime contractor"@en-US ,
        "principal contractor"@en-GB ;
    skos:definition "The company that holds the main construction agreement with the owner and manages the trades that do the work."@en ;
    skos:scopeNote "Principal contractor is the CDM 2015 duty holder in the UK, close but not the same"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00103 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00076 ;
    skos:notation "aeco-00103" ;
    skos:prefLabel "Construction manager"@en-US , "Construction manager"@en-GB ;
    skos:altLabel "CM"@en-US ;
    skos:definition "A company that manages the building work for the owner, as an advisor or as the party that holds the trade agreements."@en ;
    skos:scopeNote "The delivery method it works under is in Contracts and commercial"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
