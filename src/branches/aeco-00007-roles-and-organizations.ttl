    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00123 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00079 ;
    skos:notation "aeco-00123" ;
    skos:prefLabel "Testing agency"@en-US , "Testing laboratory"@en-GB ;
    skos:altLabel "materials testing firm"@en-US ,
        "testing laboratory"@en-US ;
    skos:definition "An independent laboratory or firm that tests materials and work, such as concrete strength and soil compaction."@en ;
    aeco:primaryTag aeco:tag-who ;
