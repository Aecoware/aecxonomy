aeco:aeco-01041 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00076 ;
    skos:notation "aeco-01041" ;
    skos:prefLabel "Surety"@en-US , "Surety"@en-GB ;
    skos:altLabel "bonding company"@en-US ,
        "surety company"@en-US ;
    skos:definition "A company that issues a bond and promises to pay or to finish the work if the contractor fails to do so."@en ;
    skos:scopeNote "Issues bonds such as a Performance bond (aeco-00155)"@en ;
    aeco:primaryTag aeco:tag-who ;
