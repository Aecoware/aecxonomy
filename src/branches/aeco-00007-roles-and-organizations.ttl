    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-01040 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00077 ;
    skos:notation "aeco-01040" ;
    skos:prefLabel "Competent person"@en-US , "Competent person"@en-GB ;
    skos:altLabel "OSHA competent person"@en-US ;
    skos:definition "Someone who can identify existing and predictable hazards on site and has the authority to correct them promptly."@en ;
    skos:scopeNote "OSHA requires one for excavations, scaffolds and fall protection. CDM 2015 uses a similar idea"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-osha1926 , aeco:std-shared ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00078 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00007 ;
    skos:notation "aeco-00078" ;
    skos:prefLabel "Authorities and inspectors"@en-US , "Authorities and inspectors"@en-GB ;
    skos:altLabel "public authorities"@en-US ,
        "regulators"@en-US ;
    skos:definition "The public bodies and officials that approve, inspect or stop work under the law."@en ;
    skos:scopeNote "The rules they enforce are in Regulations and permits"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
