    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00105 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00076 ;
    skos:notation "aeco-00105" ;
    skos:prefLabel "Subcontractor"@en-US , "Subcontractor"@en-GB ;
    skos:altLabel "specialty contractor"@en-US ,
        "sub"@en-US ,
        "trade contractor"@en-US ,
        "trade contractor"@en-GB ;
    skos:definition "A company that has an agreement with the general contractor or another trade to do one part of the work."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00106 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00076 ;
    skos:notation "aeco-00106" ;
    skos:prefLabel "Supplier"@en-US , "Supplier"@en-GB ;
    skos:altLabel "distributor"@en-US ,
        "material supplier"@en-US ,
        "vendor"@en-US ,
        "merchant"@en-GB ;
    skos:definition "A company that sells and delivers products or materials to a project, without installing them."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00107 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00076 ;
    skos:notation "aeco-00107" ;
    skos:prefLabel "Manufacturer"@en-US , "Manufacturer"@en-GB ;
    skos:altLabel "OEM"@en-US ,
        "product manufacturer"@en-US ;
    skos:definition "A company that makes products for use in built assets and gives the product data and warranties."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
