    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00962 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00077 ;
    skos:notation "aeco-00962" ;
    skos:prefLabel "Craft worker"@en-US , "Operative"@en-GB ;
    skos:altLabel "craftsperson"@en-US ,
        "field labor"@en-US ,
        "trade worker"@en-US ,
        "tradesperson"@en-US ,
        "worker"@en-US ,
        "site operative"@en-GB ,
        "tradesperson"@en-GB ;
    skos:definition "A skilled or semi-skilled person who does the hands-on work of a trade, such as a carpenter, electrician or laborer."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
