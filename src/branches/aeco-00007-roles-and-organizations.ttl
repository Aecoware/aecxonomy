aeco:aeco-00963 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00076 ;
    skos:notation "aeco-00963" ;
    skos:prefLabel "Crew"@en-US , "Work gang"@en-GB ;
    skos:altLabel "trade crew"@en-US ,
        "work crew"@en-US ,
        "crew"@en-GB ,
        "gang"@en-GB ;
    skos:definition "A small team of craft workers, led by a foreman, that does one activity or trade scope on site."@en ;
    skos:scopeNote "A group, not a firm. Its members are each a Craft worker"@en ;
    aeco:primaryTag aeco:tag-who ;
