    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00104 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00076 ;
    skos:notation "aeco-00104" ;
    skos:prefLabel "Design-builder"@en-US , "Design and build contractor"@en-GB ;
    skos:altLabel "DB entity"@en-US ,
        "design-build contractor"@en-US ;
    skos:definition "A single company or team that holds one agreement with the owner for all design and construction work."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
