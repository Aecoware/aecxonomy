aeco:aeco-00007 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00007" ;
    skos:prefLabel "Roles and organizations"@en-US , "Roles and organisations"@en-GB ;
    skos:altLabel "actors"@en-US ,
        "construction agent"@en-US ,
        "project parties"@en-US ;
    skos:definition "A person, company or authority that takes part in a project, and the function that it has. Examples are an owner, an architect and an authority having jurisdiction."@en ;
    skos:scopeNote "Owner, architect, general contractor, superintendent, authority having jurisdiction"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Resources" ;
    aeco:depthLimit 3 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00074 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00007 ;
    skos:notation "aeco-00074" ;
    skos:prefLabel "Owner and client parties"@en-US , "Client parties"@en-GB ;
    skos:altLabel "client side"@en-US ,
        "owner side"@en-US ;
    skos:definition "The organizations that start, pay for, use or hold a built asset. They set the requirements for the project."@en ;
    skos:scopeNote "Owner, developer, owner's representative, program manager, tenant, lender, facility manager"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00089 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00074 ;
    skos:notation "aeco-00089" ;
    skos:prefLabel "Owner"@en-US , "Client"@en-GB ;
    skos:altLabel "building owner"@en-US ,
        "project owner"@en-US ,
        "employer"@en-GB ;
    skos:definition "The party that pays for a project and holds the built asset when the work is complete."@en ;
    skos:scopeNote "RIBA and most UK forms say client. JCT says employer"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00090 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00074 ;
    skos:notation "aeco-00090" ;
    skos:prefLabel "Developer"@en-US , "Developer"@en-GB ;
    skos:altLabel "real estate developer"@en-US ,
        "property developer"@en-GB ;
    skos:definition "A company that starts a project to sell or lease the built asset, and arranges the land, money and team."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00091 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00074 ;
    skos:notation "aeco-00091" ;
    skos:prefLabel "Owner's representative"@en-US , "Client's representative"@en-GB ;
    skos:altLabel "owner's project manager"@en-US ,
        "owner's rep"@en-US ,
        "employer's agent"@en-GB ;
    skos:definition "A person or company that acts for the client on a project and manages the other parties on its behalf."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00092 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00074 ;
    skos:notation "aeco-00092" ;
    skos:prefLabel "Program manager"@en-US , "Programme manager"@en-GB ;
    skos:altLabel "PgM"@en-US ;
    skos:definition "A person or company that manages a group of related projects for an owner, with shared goals and budget."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00093 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00074 ;
    skos:notation "aeco-00093" ;
    skos:prefLabel "Tenant"@en-US , "Tenant"@en-GB ;
    skos:altLabel "end user"@en-US ,
        "lessee"@en-US ,
        "occupant"@en-US ;
    skos:definition "A party that leases and uses all or part of a built asset from its owner."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00094 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00074 ;
    skos:notation "aeco-00094" ;
    skos:prefLabel "Lender"@en-US , "Funder"@en-GB ;
    skos:altLabel "construction lender"@en-US ,
        "financier"@en-US ;
    skos:definition "A bank or other party that lends money for a project and sets conditions on how the money is used."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00095 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00074 ;
    skos:notation "aeco-00095" ;
    skos:prefLabel "Facility manager"@en-US , "Facilities manager"@en-GB ;
    skos:altLabel "FM"@en-US ,
        "building manager"@en-US ;
    skos:definition "A person or company that operates and maintains a built asset for its owner after handover."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
