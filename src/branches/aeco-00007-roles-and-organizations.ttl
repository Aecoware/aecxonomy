    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00100 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00075 ;
    skos:notation "aeco-00100" ;
    skos:prefLabel "Landscape architect"@en-US , "Landscape architect"@en-GB ;
    skos:definition "A licensed design professional who designs the outdoor spaces, planting and hardscape of a site."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00101 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00075 ;
    skos:notation "aeco-00101" ;
    skos:prefLabel "Specialty consultant"@en-US , "Specialist consultant"@en-GB ;
    skos:altLabel "specialist consultant"@en-US ;
    skos:definition "A design professional with knowledge of one narrow area, such as acoustics, lighting or vertical transport, who supports the design team."@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-01036 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00075 ;
    skos:notation "aeco-01036" ;
    skos:prefLabel "Engineer of record"@en-US , "Engineer of record"@en-GB ;
    skos:altLabel "design engineer"@en-US ,
        "engineer"@en-US ,
        "registered design professional"@en-US ;
    skos:hiddenLabel "EOR"@en-US ;
    skos:definition "The licensed design professional who is responsible for one discipline's design and who seals its drawings, calculations and specifications."@en ;
    skos:scopeNote "Discipline engineers such as the Structural engineer (aeco-00097) are often the engineer of record for their part"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00076 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00007 ;
    skos:notation "aeco-00076" ;
    skos:prefLabel "Construction parties"@en-US , "Construction parties"@en-GB ;
    skos:altLabel "construction team"@en-US ;
    skos:definition "The companies that build a built asset, or supply the products and labor for the work."@en ;
    skos:scopeNote "General contractor, construction manager, design-builder, subcontractor, supplier, manufacturer"@en ;
    aeco:primaryTag aeco:tag-who ;
    aeco:tag aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
