# Branch aeco-00006: Phases
# Generated by scripts/taxo.py from accepted review decisions. Edit through the review, not by hand.

@prefix aeco: <https://w3id.org/aeco/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aeco:aeco-00006 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00006" ;
    skos:prefLabel "Phases"@en-US , "Stages"@en-GB ;
    skos:altLabel "lifecycle stage"@en-US ,
        "project phase"@en-US ,
        "project stage"@en-US ;
    skos:definition "A period in the life of a project or a built asset, with a start, an end and expected outputs. Examples are design, construction and operations."@en ;
    skos:scopeNote "Design, preconstruction, construction, closeout, operations"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Process" ;
    aeco:depthLimit 3 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00016 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00006 ;
    skos:notation "aeco-00016" ;
    skos:prefLabel "Planning"@en-US , "Inception"@en-GB ;
    skos:altLabel "pre-design"@en-US ,
        "project initiation"@en-US ;
    skos:definition "The phase in which an owner identifies a need and decides if a project is possible and worth the investment."@en ;
    skos:scopeNote "Business case, feasibility, programming. In the UK, planning means planning permission, so the en-GB label is Inception"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00033 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00016 ;
    skos:notation "aeco-00033" ;
    skos:prefLabel "Business case"@en-US , "Business case"@en-GB ;
    skos:definition "The part of planning in which the owner sets out why the project is needed and what value it must give."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00034 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00016 ;
    skos:notation "aeco-00034" ;
    skos:prefLabel "Feasibility"@en-US , "Feasibility"@en-GB ;
    skos:altLabel "feasibility phase"@en-US ;
    skos:definition "The part of planning in which people study if a project is possible within its budget, schedule and site constraints."@en ;
    skos:scopeNote "The feasibility study document sits in Information"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00035 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00016 ;
    skos:notation "aeco-00035" ;
    skos:prefLabel "Programming"@en-US , "Briefing"@en-GB ;
    skos:altLabel "architectural programming"@en-US ,
        "pre-design programming"@en-US ;
    skos:definition "The part of planning in which the owner and the architect define the spaces, functions and requirements of the asset."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00017 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00006 ;
    skos:notation "aeco-00017" ;
    skos:prefLabel "Design"@en-US , "Design"@en-GB ;
    skos:altLabel "design phase"@en-US ;
    skos:definition "The phase in which architects and engineers develop the form, systems and details of a built asset into documents for construction."@en ;
    skos:scopeNote "Schematic design, design development, construction documents. Close to RIBA stages 2 to 4"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00036 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00017 ;
    skos:notation "aeco-00036" ;
    skos:prefLabel "Schematic design"@en-US ;
    skos:altLabel "SD"@en-US ,
        "schematic design phase"@en-US ;
    skos:definition "The first stage, in which the architect sets the general layout, size and form of the asset."@en ;
    skos:scopeNote "Close to RIBA stage 2, concept design"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-aia ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00037 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00017 ;
    skos:notation "aeco-00037" ;
    skos:prefLabel "Design development"@en-US ;
    skos:altLabel "DD"@en-US ,
        "design development phase"@en-US ;
    skos:definition "The middle stage, in which the architect and engineers fix the size and type of the main systems and materials."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-aia ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00038 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00017 ;
    skos:notation "aeco-00038" ;
    skos:prefLabel "Construction documents phase"@en-US ;
    skos:altLabel "CD phase"@en-US ;
    skos:definition "The last stage, in which the architect and engineers prepare the drawings and specifications that contractors use to bid and build."@en ;
    skos:scopeNote "The document set itself sits in Information"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-aia ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00018 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00006 ;
    skos:notation "aeco-00018" ;
    skos:prefLabel "Procurement"@en-US , "Procurement"@en-GB ;
    skos:altLabel "bidding and negotiation phase"@en-US ;
    skos:definition "The phase in which the owner selects contractors and suppliers and agrees contracts with them."@en ;
    skos:scopeNote "Bidding, negotiation, buyout"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00039 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00018 ;
    skos:notation "aeco-00039" ;
    skos:prefLabel "Bidding"@en-US , "Tendering"@en-GB ;
    skos:altLabel "bid phase"@en-US ,
        "bidding phase"@en-US ;
    skos:definition "The part of procurement in which contractors prepare and submit competing prices for the work."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00040 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00018 ;
    skos:notation "aeco-00040" ;
    skos:prefLabel "Negotiation"@en-US , "Negotiation"@en-GB ;
    skos:altLabel "negotiated procurement"@en-US ;
    skos:definition "The part of procurement in which the owner and one contractor agree on price, scope and terms without competing prices."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00041 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00018 ;
    skos:notation "aeco-00041" ;
    skos:prefLabel "Buyout"@en-US ;
    skos:altLabel "subcontract buyout"@en-US ,
        "subcontract procurement"@en-US ;
    skos:definition "The period after contract award in which the general contractor selects subcontractors and suppliers and agrees contracts with them."@en ;
    skos:scopeNote "US term. Overlaps the start of construction"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00019 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00006 ;
    skos:notation "aeco-00019" ;
    skos:prefLabel "Construction"@en-US , "Construction"@en-GB ;
    skos:altLabel "construction phase"@en-US ,
        "execution phase"@en-US ;
    skos:definition "The phase in which contractors build the asset on site, from mobilization to substantial completion."@en ;
    skos:scopeNote "Mobilization to substantial completion. ISO 22263 calls it production"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00020 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00006 ;
    skos:notation "aeco-00020" ;
    skos:prefLabel "Closeout"@en-US , "Handover"@en-GB ;
    skos:altLabel "commissioning and closeout"@en-US ,
        "project closeout"@en-US ;
    skos:definition "The phase in which the contractor finishes the last work, hands over documents and systems, and the owner takes over the asset."@en ;
    skos:scopeNote "From substantial completion to final completion: commissioning, punch list, turnover"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00042 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00020 ;
    skos:notation "aeco-00042" ;
    skos:prefLabel "Commissioning phase"@en-US , "Commissioning phase"@en-GB ;
    skos:altLabel "Cx phase"@en-US ;
    skos:definition "The part of closeout in which a team tests the systems of the asset and confirms that they work as the owner requires."@en ;
    skos:scopeNote "The period of final testing. The commissioning process starts in design and sits in Processes and services, with the label Commissioning"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00043 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00020 ;
    skos:notation "aeco-00043" ;
    skos:prefLabel "Turnover"@en-US ;
    skos:altLabel "owner turnover"@en-US ,
        "project turnover"@en-US ;
    skos:definition "The part of closeout in which the contractor gives the owner the documents, warranties, keys and training needed to run the asset."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00021 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00006 ;
    skos:notation "aeco-00021" ;
    skos:prefLabel "Operations"@en-US , "Operations"@en-GB ;
    skos:altLabel "O&M"@en-US ,
        "operations and maintenance"@en-US ,
        "use phase"@en-US ;
    skos:definition "The phase in which people use, run and maintain the asset."@en ;
    skos:scopeNote "Use, operation and maintenance. Starts at handover"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00022 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00006 ;
    skos:notation "aeco-00022" ;
    skos:prefLabel "End of life"@en-US , "End of life"@en-GB ;
    skos:altLabel "decommissioning and disposal"@en-US ;
    skos:definition "The phase in which the owner takes an asset out of use and removes, demolishes or reuses it."@en ;
    skos:scopeNote "Decommissioning, demolition, reuse of parts and materials"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00044 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00022 ;
    skos:notation "aeco-00044" ;
    skos:prefLabel "Decommissioning"@en-US , "Decommissioning"@en-GB ;
    skos:altLabel "shutdown"@en-US ;
    skos:definition "The part of end of life in which the owner stops the use of the asset and makes its systems safe."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00045 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00022 ;
    skos:notation "aeco-00045" ;
    skos:prefLabel "Demolition phase"@en-US , "Demolition phase"@en-GB ;
    skos:altLabel "dismantling phase"@en-US ;
    skos:definition "The part of end of life in which contractors take the asset down and remove or reuse its parts and materials."@en ;
    skos:scopeNote "Demolition as trade work sits in Work results, with the label Demolition"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00023 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00006 ;
    skos:notation "aeco-00023" ;
    skos:prefLabel "Preconstruction"@en-US , "Pre-construction"@en-GB ;
    skos:altLabel "precon"@en-US ,
        "preconstruction services"@en-US ;
    skos:definition "The phase in which a contractor supports the design team with estimates, schedules and constructability reviews before work on site starts."@en ;
    skos:scopeNote "Runs in parallel with design and procurement under CM at risk and design-build"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00024 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00006 ;
    skos:notation "aeco-00024" ;
    skos:prefLabel "Permitting"@en-US ;
    skos:altLabel "approvals phase"@en-US ,
        "permit phase"@en-US ;
    skos:definition "The phase in which the owner and the design team get the approvals that an authority requires before work starts."@en ;
    skos:scopeNote "Land-use approvals (entitlements) and building permits. Overlaps design. Permits themselves sit in Regulations and permits"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00025 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00006 ;
    skos:notation "aeco-00025" ;
    skos:prefLabel "Renovation"@en-US , "Refurbishment"@en-GB ;
    skos:altLabel "remodel"@en-US ,
        "renewal"@en-US ,
        "retrofit"@en-US ;
    skos:definition "A phase in which the owner changes or upgrades an asset in use, as a new project inside its life."@en ;
    skos:scopeNote "Repeats the main sequence on a smaller scale. EN 16310 calls it revamping"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .
