    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00305 ;
    skos:notation "aeco-00422" ;
    skos:prefLabel "Climate zone"@en-US , "Climate zone"@en-GB ;
    skos:altLabel "energy climate zone"@en-US ;
    skos:definition "A mapped area with similar temperature and humidity, which the energy code uses to set insulation and system rules."@en ;
    skos:scopeNote "US: IECC and ASHRAE 169 zones"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00423 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00305 ;
    skos:notation "aeco-00423" ;
    skos:prefLabel "Flood zone"@en-US , "Flood zone"@en-GB ;
    skos:altLabel "flood hazard area"@en-US ,
        "floodplain"@en-US ,
        "special flood hazard area"@en-US ;
    skos:definition "A mapped area with a set yearly chance of flooding, which drives elevation, construction and insurance rules."@en ;
    skos:scopeNote "US: FEMA flood maps. The event is Flood (aeco-00071)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00424 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00305 ;
    skos:notation "aeco-00424" ;
    skos:prefLabel "Seismic hazard zone"@en-US , "Seismic hazard zone"@en-GB ;
    skos:altLabel "earthquake zone"@en-US ,
        "fault zone"@en-US ,
        "liquefaction zone"@en-US ;
    skos:definition "A mapped area with a set level of earthquake ground shaking, fault rupture or soil failure."@en ;
    skos:scopeNote "Seismic design category is a value in Properties"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00425 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00305 ;
    skos:notation "aeco-00425" ;
    skos:prefLabel "Wildfire zone"@en-US , "Wildfire zone"@en-GB ;
    skos:altLabel "WUI"@en-US ,
        "fire hazard severity zone"@en-US ,
        "wildland-urban interface"@en-US ;
    skos:definition "A mapped area where facilities meet wild land with a high risk of fire."@en ;
    skos:scopeNote "US: the IWUIC and state maps. The event is Wildfire (aeco-00073)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00426 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00305 ;
    skos:notation "aeco-00426" ;
    skos:prefLabel "High wind zone"@en-US , "High wind zone"@en-GB ;
    skos:altLabel "hurricane-prone region"@en-US ,
        "wind-borne debris region"@en-US ;
    skos:definition "A mapped area with high design wind speeds, such as a hurricane-prone or wind-borne debris region."@en ;
    skos:scopeNote "Wind exposure category is a value in Properties"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00427 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00305 ;
    skos:notation "aeco-00427" ;
    skos:prefLabel "Landslide zone"@en-US , "Landslide zone"@en-GB ;
    skos:altLabel "landslide hazard area"@en-US ,
        "unstable slope area"@en-US ,
        "landslip zone"@en-GB ;
    skos:definition "A mapped area where slopes can fail and move down, because of soil, water or earthquakes."@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00306 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00014 ;
    skos:notation "aeco-00306" ;
    skos:prefLabel "Existing site features"@en-US , "Existing site features"@en-GB ;
    skos:altLabel "existing site elements"@en-US ,
        "pre-existing features"@en-US ;
    skos:definition "Things that people built on or under the land before the work starts."@en ;
    skos:scopeNote "Neighbors are Adjacent property"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00428 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00306 ;
    skos:notation "aeco-00428" ;
    skos:prefLabel "Existing structure"@en-US , "Existing structure"@en-GB ;
    skos:altLabel "existing building"@en-US ,
        "structure to remain"@en-US ;
    skos:definition "A building or other construction that stands on the site before the work, and that the work keeps, alters or removes."@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00429 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00306 ;
    skos:notation "aeco-00429" ;
    skos:prefLabel "Existing utility"@en-US , "Existing services"@en-GB ;
    skos:altLabel "buried utility"@en-US ,
        "existing service line"@en-US ,
        "underground utility"@en-US ,
        "statutory undertaker's apparatus"@en-GB ;
    skos:definition "A pipe, cable or duct of a public or private service network that is on or under a site before the work starts."@en ;
    skos:scopeNote "Locate before digging (811 in the US). New utility systems are in Elements and systems"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00430 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00306 ;
    skos:notation "aeco-00430" ;
    skos:prefLabel "Existing site improvement"@en-US , "Existing external works"@en-GB ;
    skos:altLabel "existing fencing"@en-US ,
        "existing hardscape"@en-US ,
        "existing paving"@en-US ;
    skos:definition "A paved area, fence, wall or planting bed that is on the land before the work starts."@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00431 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00306 ;
    skos:notation "aeco-00431" ;
    skos:prefLabel "Hazardous building material"@en-US , "Hazardous building material"@en-GB ;
    skos:altLabel "ACM"@en-US ,
        "asbestos-containing material"@en-US ,
        "lead-based paint"@en-US ;
    skos:definition "A substance in an existing structure that can harm health when disturbed, such as asbestos, lead paint or PCBs."@en ;
    skos:scopeNote "The rules are in Hazardous building material rule"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .
