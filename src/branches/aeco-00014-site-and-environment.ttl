aeco:aeco-00014 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00014" ;
    skos:prefLabel "Site and environment"@en-US , "Site and environment"@en-GB ;
    skos:altLabel "existing conditions"@en-US ,
        "ground conditions"@en-US ,
        "site conditions"@en-US ;
    skos:definition "The land where a built asset is or will be, and the natural conditions of that land. Examples are geology, groundwater, terrain and protected areas."@en ;
    skos:scopeNote "Land, geology, groundwater, terrain, protected areas. Measurements of the site stay in Properties"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Added" ;
    aeco:depthLimit 3 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00301 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00014 ;
    skos:notation "aeco-00301" ;
