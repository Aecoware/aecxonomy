    skos:definition "The legal parcels, their edges and the rights that others hold over them."@en ;
    skos:scopeNote "Survey data is in Geospatial data (aeco-00245). The surveyor is Land surveyor (aeco-00122)"@en ;
    aeco:primaryTag aeco:tag-where ;
