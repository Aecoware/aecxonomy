aeco:aeco-00011 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00011" ;
    skos:prefLabel "Contracts and commercial"@en-US , "Contracts and commercial"@en-GB ;
    skos:altLabel "commercial management"@en-US ,
        "contracts"@en-US ;
    skos:definition "The agreements between parties on a project, and the money, risk and obligations that the agreements control. Examples are a delivery method, a contract form and retainage."@en ;
    skos:scopeNote "Delivery methods, contract forms, payment applications, retainage, bonds"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Added" ;
    aeco:depthLimit 3 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00081 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00011 ;
    skos:notation "aeco-00081" ;
    skos:prefLabel "Project delivery methods"@en-US , "Procurement routes"@en-GB ;
    skos:altLabel "delivery methods"@en-US ,
        "delivery models"@en-US ,
        "procurement routes"@en-GB ;
    skos:definition "The way an owner divides design and construction among parties and contracts, and how those parties work together."@en ;
    skos:scopeNote "Design-bid-build, design-build, CM at risk, IPD and others"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00127 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00081 ;
    skos:notation "aeco-00127" ;
    skos:prefLabel "Design-bid-build"@en-US , "Traditional procurement"@en-GB ;
    skos:altLabel "DBB"@en-US ,
        "traditional delivery"@en-US ;
    skos:definition "A method in which the owner hires a designer first, then hires a contractor through a separate bid for the finished design."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00128 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00081 ;
    skos:notation "aeco-00128" ;
    skos:prefLabel "Design-build"@en-US , "Design and build"@en-GB ;
    skos:altLabel "DB"@en-US ,
        "D&B"@en-GB ;
    skos:definition "A method in which one party holds a single agreement with the owner for both design and construction."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00129 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00081 ;
    skos:notation "aeco-00129" ;
    skos:prefLabel "Progressive design-build"@en-US ;
    skos:altLabel "PDB"@en-US ;
    skos:definition "A design-build method in which the price is agreed in steps as the design develops, not at the start."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-dbia ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00130 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00081 ;
    skos:notation "aeco-00130" ;
    skos:prefLabel "Construction manager at risk"@en-US ;
    skos:altLabel "CM at risk"@en-US ,
        "CM/GC"@en-US ,
        "CMAR"@en-US ;
    skos:definition "A method in which one firm advises the owner during design, then holds the trade agreements and builds under a guaranteed maximum price."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00131 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00081 ;
    skos:notation "aeco-00131" ;
    skos:prefLabel "Construction manager as advisor"@en-US , "Construction management"@en-GB ;
    skos:altLabel "CM as agent"@en-US ,
        "CMa"@en-US ,
        "agency CM"@en-US ;
    skos:definition "A method in which a firm gives the owner advice on cost, time and quality for a fee, while the owner holds the trade agreements."@en ;
    skos:scopeNote "UK construction management is close: the client holds the trade contracts"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00132 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00081 ;
    skos:notation "aeco-00132" ;
    skos:prefLabel "Integrated project delivery"@en-US , "Integrated project delivery"@en-GB ;
    skos:altLabel "IPD"@en-US ,
        "alliancing"@en-GB ;
    skos:definition "A method in which the owner, designer and builder sign one agreement and share risk and reward for the overall result."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-aia , aeco:std-consensusdocs ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00133 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00081 ;
    skos:notation "aeco-00133" ;
    skos:prefLabel "Multi-prime"@en-US ;
    skos:altLabel "multiple prime contracts"@en-US ;
    skos:definition "A method in which the owner holds separate agreements with several trade contractors and coordinates them or hires a party to do so."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00082 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00011 ;
    skos:notation "aeco-00082" ;
    skos:prefLabel "Contract pricing types"@en-US , "Contract pricing types"@en-GB ;
    skos:altLabel "compensation methods"@en-US ,
        "pricing arrangements"@en-US ;
    skos:definition "The way an agreement sets the price of the work and how that price can change."@en ;
    skos:scopeNote "Lump sum, cost plus, GMP, unit price, time and materials"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00134 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00082 ;
    skos:notation "aeco-00134" ;
    skos:prefLabel "Lump sum"@en-US , "Lump sum"@en-GB ;
    skos:altLabel "fixed price"@en-US ,
        "stipulated sum"@en-US ;
    skos:hiddenLabel "LS"@en-US ;
    skos:definition "A price type in which the contractor agrees to do the defined work for one fixed amount."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00135 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00082 ;
    skos:notation "aeco-00135" ;
    skos:prefLabel "Cost plus fee"@en-US , "Cost reimbursable"@en-GB ;
    skos:altLabel "cost of the work plus a fee"@en-US ,
        "cost-plus"@en-US ;
    skos:definition "A price type in which the owner pays the actual cost of the work plus a fee for the contractor."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00136 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00082 ;
    skos:notation "aeco-00136" ;
    skos:prefLabel "Guaranteed maximum price"@en-US , "Guaranteed maximum price"@en-GB ;
    skos:altLabel "GMP"@en-US ;
    skos:definition "A cost plus fee arrangement with an upper limit. The contractor pays any cost above the limit unless the scope changes."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00137 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00082 ;
    skos:notation "aeco-00137" ;
    skos:prefLabel "Unit price"@en-US , "Remeasurement"@en-GB ;
    skos:altLabel "unit rate"@en-US ,
        "measurement contract"@en-GB ;
    skos:definition "An arrangement in which the owner pays a fixed rate for each measured unit of work, such as each cubic yard."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00138 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00082 ;
    skos:notation "aeco-00138" ;
    skos:prefLabel "Time and materials"@en-US , "Daywork"@en-GB ;
    skos:altLabel "T&M"@en-US ,
        "force account"@en-US ;
    skos:definition "An arrangement in which the owner pays for actual labor hours at agreed rates, plus the cost of supplies used."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00083 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00011 ;
    skos:notation "aeco-00083" ;
    skos:prefLabel "Agreement types"@en-US , "Agreement types"@en-GB ;
    skos:altLabel "contract forms"@en-US ,
        "standard forms"@en-US ;
    skos:definition "The kinds of contracts between project parties, named by who signs them and what they cover."@en ;
    skos:scopeNote "Generic types. Named forms such as AIA A101 or ConsensusDocs 200 appear in scope notes and standard sets, not as concepts"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00139 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00083 ;
    skos:notation "aeco-00139" ;
    skos:prefLabel "Owner-architect agreement"@en-US ;
    skos:altLabel "design services agreement"@en-US ,
        "owner-design professional agreement"@en-US ,
        "architect's appointment"@en-GB ;
    skos:definition "The contract between the client and the lead designer that sets the design services, fee and responsibilities."@en ;
    skos:scopeNote "Forms: AIA B101, ConsensusDocs 240"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00140 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00083 ;
    skos:notation "aeco-00140" ;
    skos:prefLabel "Owner-contractor agreement"@en-US ;
    skos:altLabel "construction contract"@en-US ,
        "prime contract"@en-US ,
        "building contract"@en-GB ,
        "main contract"@en-GB ;
    skos:definition "The main construction contract between the party that pays for the project and the party that builds it."@en ;
    skos:scopeNote "Forms: AIA A101 and A102, ConsensusDocs 200"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00141 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00083 ;
    skos:notation "aeco-00141" ;
    skos:prefLabel "Subcontract"@en-US , "Subcontract"@en-GB ;
    skos:altLabel "subcontract agreement"@en-US ;
    skos:definition "A contract in which a contractor hires another company to do part of its work under the main contract."@en ;
    skos:scopeNote "Forms: AIA A401, ConsensusDocs 750"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00142 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00083 ;
    skos:notation "aeco-00142" ;
    skos:prefLabel "Consultant agreement"@en-US , "Sub-consultant appointment"@en-GB ;
    skos:altLabel "architect-consultant agreement"@en-US ,
        "subconsultant agreement"@en-US ;
    skos:definition "A contract in which a lead designer hires another design professional, such as an engineer, for part of the design."@en ;
    skos:scopeNote "Form: AIA C401"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00143 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00083 ;
    skos:notation "aeco-00143" ;
    skos:prefLabel "Purchase order"@en-US , "Purchase order"@en-GB ;
    skos:altLabel "PO"@en-US ;
    skos:definition "A short contract to buy products or materials at an agreed price, quantity and delivery date."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00144 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00083 ;
    skos:notation "aeco-00144" ;
    skos:prefLabel "Joint venture agreement"@en-US , "Joint venture agreement"@en-GB ;
    skos:altLabel "JV"@en-US ,
        "JV agreement"@en-US ;
    skos:definition "A contract in which two or more companies combine to do a project and share its risk and profit."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00145 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00083 ;
    skos:notation "aeco-00145" ;
    skos:prefLabel "Master service agreement"@en-US , "Framework agreement"@en-GB ;
    skos:altLabel "MSA"@en-US ,
        "master agreement"@en-US ;
    skos:definition "A contract that sets general terms for repeated work between two parties, with each job ordered under it."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00958 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00083 ;
    skos:notation "aeco-00958" ;
    skos:prefLabel "Project labor agreement"@en-US ;
    skos:altLabel "PLA"@en-US ,
        "community workforce agreement"@en-US ;
    skos:definition "A pre-hire collective bargaining contract with building trades unions that sets wages, hours and work rules on one job."@en ;
    skos:scopeNote "Often tied to a Prevailing wage requirement (aeco-00362). US practice"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what , aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00084 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00011 ;
    skos:notation "aeco-00084" ;
    skos:prefLabel "Changes and claims"@en-US , "Changes and claims"@en-GB ;
    skos:altLabel "contract modifications"@en-US ;
    skos:definition "The written steps that parties use to adjust the agreed scope, price or time, or to demand more."@en ;
    skos:scopeNote "The events that cause changes are in Events and risks"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00146 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00084 ;
    skos:notation "aeco-00146" ;
    skos:prefLabel "Potential change order"@en-US ;
    skos:altLabel "COR"@en-US ,
        "PCO"@en-US ,
        "change order request"@en-US ;
    skos:definition "A notice that extra cost or time may come from an event, before the parties agree on an amendment."@en ;
    skos:scopeNote "US practice"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00147 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00084 ;
    skos:notation "aeco-00147" ;
    skos:prefLabel "Construction change directive"@en-US ;
    skos:altLabel "CCD"@en-US ;
    skos:definition "A written order from the owner to do changed work before the parties agree on its price or time."@en ;
    skos:scopeNote "ConsensusDocs uses interim directed change, close"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-aia ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00148 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00084 ;
    skos:notation "aeco-00148" ;
    skos:prefLabel "Claim"@en-US , "Claim"@en-GB ;
    skos:altLabel "contract claim"@en-US ,
        "request for equitable adjustment"@en-US ;
    skos:hiddenLabel "REA"@en-US ;
    skos:definition "A formal demand by one party for more money, more time or another remedy under the contract."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00172 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00084 ;
    skos:notation "aeco-00172" ;
    skos:prefLabel "Change order"@en-US ;
    skos:altLabel "CO"@en-US ;
    skos:definition "A signed amendment to the agreement that adjusts the scope, price or time of the work."@en ;
    skos:scopeNote "Signed by both parties. Close UK concepts: the JCT variation, instructed by one party and valued after, and the NEC4 compensation event. 'Variation order' is shorthand in UK and FIDIC practice, not a JCT or NEC term."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-aia , aeco:std-consensusdocs ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00173 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00084 ;
    skos:notation "aeco-00173" ;
    skos:prefLabel "Architect's supplemental instruction"@en-US ;
    skos:altLabel "ASI"@en-US ,
        "minor change in the work"@en-US ;
    skos:definition "A written notice from the lead designer that clarifies the documents or orders a small adjustment, with no change to price or time."@en ;
    skos:scopeNote "AIA form G710. A201 section 7.4 allows minor changes this way. It also carries clarifications and interpretations. The EJCDC field order is close."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-aia ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00959 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00084 ;
    skos:notation "aeco-00959" ;
    skos:prefLabel "Back charge"@en-US , "Contra charge"@en-GB ;
    skos:altLabel "backcharge"@en-US ,
        "contra charge"@en-US ,
        "set-off"@en-GB ;
    skos:definition "A cost one party deducts from what it owes another, to recover work it did or damage it fixed for that party."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-01046 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00084 ;
    skos:notation "aeco-01046" ;
    skos:prefLabel "Time extension"@en-US , "Extension of time"@en-GB ;
    skos:altLabel "contract time extension"@en-US ;
    skos:hiddenLabel "EOT"@en-US ;
    skos:definition "A change to the contract duration that gives the contractor more days to reach a milestone or completion."@en ;
    skos:scopeNote "Usually follows an Excusable delay (aeco-00054)"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00085 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00011 ;
    skos:notation "aeco-00085" ;
    skos:prefLabel "Payment and money"@en-US , "Payment and money"@en-GB ;
    skos:altLabel "funds flow"@en-US ,
        "payments"@en-US ;
    skos:definition "The tools that parties use to plan, request, hold back and release funds during a project."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00149 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00085 ;
    skos:notation "aeco-00149" ;
    skos:prefLabel "Schedule of values"@en-US ;
    skos:altLabel "SOV"@en-US ,
        "cost breakdown"@en-US ,
        "activity schedule"@en-GB ,
        "contract sum analysis"@en-GB ;
    skos:definition "A list that divides the contract sum into parts of the work, used to measure progress for payment."@en ;
    skos:scopeNote "US practice. UK close equivalents as en-GB alternatives"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00150 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00085 ;
    skos:notation "aeco-00150" ;
    skos:prefLabel "Payment application"@en-US , "Application for payment"@en-GB ;
    skos:altLabel "pay app"@en-US ,
        "progress billing"@en-US ,
        "requisition"@en-US ,
        "interim valuation"@en-GB ;
    skos:definition "A request from the contractor to be paid for the work done in a period, with the supporting documents."@en ;
    skos:scopeNote "Form: AIA G702 and G703"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00151 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00085 ;
    skos:notation "aeco-00151" ;
    skos:prefLabel "Retainage"@en-US , "Retention"@en-GB ;
    skos:altLabel "holdback"@en-US ,
        "retention money"@en-US ;
    skos:definition "A part of each payment that the owner holds back until the work is complete, as security."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00152 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00085 ;
    skos:notation "aeco-00152" ;
    skos:prefLabel "Lien waiver"@en-US ;
    skos:altLabel "lien release"@en-US ,
        "release of lien"@en-US ;
    skos:definition "A signed release in which a contractor or supplier gives up its right to place a lien for amounts paid."@en ;
    skos:scopeNote "US practice under state lien laws. No UK equivalent"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00153 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00085 ;
    skos:notation "aeco-00153" ;
    skos:prefLabel "Allowance"@en-US , "Provisional sum"@en-GB ;
    skos:altLabel "cash allowance"@en-US ,
        "PC sum"@en-GB ;
    skos:definition "An amount in the contract sum for an item that is not yet fully defined, adjusted when the actual cost is known."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00154 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00085 ;
    skos:notation "aeco-00154" ;
    skos:prefLabel "Contingency"@en-US , "Contingency"@en-GB ;
    skos:altLabel "contingency fund"@en-US ,
        "reserve"@en-US ;
    skos:definition "An amount set aside in a budget or contract to pay for costs that the parties did not foresee."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00957 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00085 ;
    skos:notation "aeco-00957" ;
    skos:prefLabel "Bid alternate"@en-US , "Bid alternate"@en-GB ;
    skos:altLabel "add alternate"@en-US ,
        "alternate"@en-US ,
        "deduct alternate"@en-US ;
    skos:definition "A separate price in a bid to add, remove or change a defined part of the scope, which the owner may accept."@en ;
    skos:scopeNote "Not an Allowance (aeco-00153), which holds money for scope not yet defined"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00086 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00011 ;
    skos:notation "aeco-00086" ;
    skos:prefLabel "Bonds and insurance"@en-US , "Bonds and insurance"@en-GB ;
    skos:altLabel "bonds"@en-US ,
        "insurance"@en-US ,
        "risk transfer"@en-US ,
        "surety and insurance"@en-US ,
        "surety bond"@en-US ;
    skos:definition "The guarantees and policies that move the cost of a loss or a failure to a surety or an insurer."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00155 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00086 ;
    skos:notation "aeco-00155" ;
    skos:prefLabel "Performance bond"@en-US , "Performance bond"@en-GB ;
    skos:definition "A guarantee from a surety that the contractor will complete the work as the contract requires."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00156 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00086 ;
    skos:notation "aeco-00156" ;
    skos:prefLabel "Payment bond"@en-US ;
    skos:altLabel "labor and material bond"@en-US ;
    skos:definition "A guarantee from a surety that the contractor will pay its subcontractors and suppliers."@en ;
    skos:scopeNote "US practice, required on public work"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00157 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00086 ;
    skos:notation "aeco-00157" ;
    skos:prefLabel "Bid bond"@en-US , "Tender bond"@en-GB ;
    skos:definition "A guarantee from a surety that a bidder will sign the contract and provide the other bonds if it wins."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00158 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00086 ;
    skos:notation "aeco-00158" ;
    skos:prefLabel "Builder's risk insurance"@en-US , "Contractors' all risks insurance"@en-GB ;
    skos:altLabel "course of construction insurance"@en-US ,
        "CAR insurance"@en-GB ;
    skos:definition "A policy that covers damage to the work and materials during construction."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00159 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00086 ;
    skos:notation "aeco-00159" ;
    skos:prefLabel "Commercial general liability insurance"@en-US , "Public liability insurance"@en-GB ;
    skos:altLabel "CGL"@en-US ;
    skos:definition "A policy that covers claims from third parties for injury or property damage caused by a company's operations."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00160 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00086 ;
    skos:notation "aeco-00160" ;
    skos:prefLabel "Professional liability insurance"@en-US , "Professional indemnity insurance"@en-GB ;
    skos:altLabel "E&O"@en-US ,
        "errors and omissions insurance"@en-US ,
        "PI insurance"@en-GB ;
    skos:definition "A policy that covers claims against a designer for errors or omissions in its services."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00961 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00086 ;
    skos:notation "aeco-00961" ;
    skos:prefLabel "Certificate of insurance"@en-US , "Certificate of insurance"@en-GB ;
    skos:altLabel "COI"@en-US ,
        "insurance certificate"@en-US ,
        "proof of insurance"@en-US ,
        "evidence of insurance"@en-GB ;
    skos:hiddenLabel "ACORD 25"@en-US ;
    skos:definition "A document from an insurer or broker that proves a firm holds the policies, limits and additional insureds that a contract requires."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00087 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00011 ;
    skos:notation "aeco-00087" ;
    skos:prefLabel "Obligations and risk allocation"@en-US , "Obligations and risk allocation"@en-GB ;
    skos:altLabel "contract clauses"@en-US ,
        "contract terms"@en-US ;
    skos:definition "The clauses that set what each party must do and which party carries a risk if something goes wrong."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00161 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00087 ;
    skos:notation "aeco-00161" ;
    skos:prefLabel "Indemnification"@en-US , "Indemnity"@en-GB ;
    skos:altLabel "hold harmless clause"@en-US ;
    skos:definition "A clause in which one party agrees to cover the losses of another party caused by stated events."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00162 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00087 ;
    skos:notation "aeco-00162" ;
    skos:prefLabel "Liquidated damages"@en-US , "Liquidated damages"@en-GB ;
    skos:altLabel "LDs"@en-US ,
        "delay damages"@en-US ,
        "LADs"@en-GB ;
    skos:definition "A fixed amount per day that the contractor pays the owner if the work is late, agreed in advance."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00163 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00087 ;
    skos:notation "aeco-00163" ;
    skos:prefLabel "Warranty"@en-US , "Warranty"@en-GB ;
    skos:altLabel "guarantee"@en-US ;
    skos:definition "A promise that the work or a product is free from defects for a stated period, with a duty to fix defects."@en ;
    skos:scopeNote "The correction period after completion is a related term"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00164 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00087 ;
    skos:notation "aeco-00164" ;
    skos:prefLabel "Limitation of liability"@en-US , "Limitation of liability"@en-GB ;
    skos:altLabel "liability cap"@en-US ;
    skos:definition "A clause that sets the most money that one party can owe another for losses under the contract."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00165 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00087 ;
    skos:notation "aeco-00165" ;
    skos:prefLabel "Waiver of consequential damages"@en-US , "Exclusion of consequential loss"@en-GB ;
    skos:altLabel "consequential damages waiver"@en-US ,
        "mutual waiver"@en-US ;
    skos:definition "A clause in which the parties give up claims for indirect losses, such as lost profit or loss of use."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00166 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00087 ;
    skos:notation "aeco-00166" ;
    skos:prefLabel "Dispute resolution"@en-US , "Dispute resolution"@en-GB ;
    skos:altLabel "claims resolution"@en-US ,
        "adjudication"@en-GB ;
    skos:definition "The agreed steps to settle disagreements between parties, such as negotiation, mediation, arbitration or litigation."@en ;
    skos:scopeNote "UK statutory adjudication is a close, narrower concept"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00960 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00087 ;
    skos:notation "aeco-00960" ;
    skos:prefLabel "Force majeure"@en-US , "Force majeure"@en-GB ;
    skos:altLabel "act of God clause"@en-US ,
        "excusable event"@en-US ;
    skos:definition "A contract term that excuses late or failed performance when events beyond the parties' control, such as war or disaster, prevent the work."@en ;
    skos:scopeNote "May give an Excusable delay (aeco-00054)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00088 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00011 ;
    skos:notation "aeco-00088" ;
    skos:prefLabel "Procurement methods"@en-US , "Procurement methods"@en-GB ;
    skos:altLabel "award methods"@en-US ,
        "selection methods"@en-US ,
        "tendering methods"@en-GB ;
    skos:definition "The ways an owner or contractor selects a party and awards an agreement for work or services."@en ;
    skos:scopeNote "The procurement phase and its steps are in Phases"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00167 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00088 ;
    skos:notation "aeco-00167" ;
    skos:prefLabel "Competitive bidding"@en-US , "Competitive tendering"@en-GB ;
    skos:altLabel "hard bid"@en-US ,
        "low bid"@en-US ,
        "sealed bid"@en-US ;
    skos:definition "A selection method in which the work goes to the lowest qualified bidder for a fixed design."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00168 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00088 ;
    skos:notation "aeco-00168" ;
    skos:prefLabel "Negotiated selection"@en-US , "Negotiated tender"@en-GB ;
    skos:altLabel "negotiated contract"@en-US ,
        "sole source"@en-US ;
    skos:definition "A method in which the owner picks a party and agrees the price and terms through discussion."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00169 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00088 ;
    skos:notation "aeco-00169" ;
    skos:prefLabel "Qualifications-based selection"@en-US , "Quality-based selection"@en-GB ;
    skos:altLabel "QBS"@en-US ;
    skos:definition "A method in which the owner ranks firms by experience and ability first, then agrees a fee with the top firm."@en ;
    skos:scopeNote "Required for US federal design services"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00170 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00088 ;
    skos:notation "aeco-00170" ;
    skos:prefLabel "Best-value selection"@en-US , "Best-value selection"@en-GB ;
    skos:altLabel "best value procurement"@en-US ,
        "MEAT"@en-GB ,
        "most economically advantageous tender"@en-GB ;
    skos:definition "A method in which the owner picks the offer with the best mix of price, quality and other stated factors."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00171 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00088 ;
