# Branch aeco-00012: Requirements and decisions
# Generated by scripts/taxo.py from accepted review decisions. Edit through the review, not by hand.

@prefix aeco: <https://w3id.org/aeco/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aeco:aeco-00012 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00012" ;
    skos:prefLabel "Requirements and decisions"@en-US , "Requirements and decisions"@en-GB ;
    skos:altLabel "criteria"@en-US ,
        "design intent"@en-US ,
        "rationale"@en-US ;
    skos:definition "A need or condition that a built asset or a project must satisfy, and a choice that a party makes, with its reasons. Examples are the owner's project requirements and a design decision."@en ;
    skos:scopeNote "Owner's project requirements, basis of design, decision types and their rationale"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Added" ;
    aeco:depthLimit 3 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00295 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00012 ;
    skos:notation "aeco-00295" ;
    skos:prefLabel "Project requirements"@en-US , "Project requirements"@en-GB ;
    skos:altLabel "client requirements"@en-US ,
        "owner requirements"@en-US ;
    skos:definition "The needs and goals that the owner sets, and the design response that shows how the team will meet them."@en ;
    skos:scopeNote "Context schema 4.5: requirements and intent. Many trade contractors never see these. Low coverage is a true picture"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00368 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00295 ;
    skos:notation "aeco-00368" ;
    skos:prefLabel "Owner's project requirements"@en-US ;
    skos:altLabel "OPR"@en-US ;
    skos:definition "A document that states the goals, functions, performance targets and success criteria that the owner expects from a facility."@en ;
    skos:scopeNote "The Commissioning agent (aeco-00119) checks the design and the work against it. Context schema 4.5"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00369 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00295 ;
    skos:notation "aeco-00369" ;
    skos:prefLabel "Basis of design"@en-US , "Basis of design"@en-GB ;
    skos:altLabel "BOD"@en-US ,
        "design basis"@en-US ;
    skos:definition "A document from the designer that explains how the design meets the owner's project requirements, with the systems, criteria and assumptions used."@en ;
    skos:scopeNote "Updated at each design stage. Context schema 4.5"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00370 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00295 ;
    skos:notation "aeco-00370" ;
    skos:prefLabel "Project goal"@en-US , "Project objective"@en-GB ;
    skos:altLabel "owner goal"@en-US ,
        "success criterion"@en-US ;
    skos:definition "A target that the owner sets for budget, schedule, quality, sustainability or use."@en ;
    skos:scopeNote "Context schema 4.5: budget, schedule and certification priorities"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00371 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00295 ;
    skos:notation "aeco-00371" ;
    skos:prefLabel "Space program"@en-US , "Schedule of accommodation"@en-GB ;
    skos:altLabel "building program"@en-US ,
        "program of requirements"@en-US ,
        "space requirements"@en-US ,
        "accommodation schedule"@en-GB ;
    skos:definition "A list of the rooms and areas that a facility needs, with their sizes, uses and adjacencies."@en ;
    skos:scopeNote "Written in the Programming (aeco-00035) phase"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00372 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00295 ;
    skos:notation "aeco-00372" ;
    skos:prefLabel "Design criteria"@en-US , "Design criteria"@en-GB ;
    skos:altLabel "design parameters"@en-US ,
        "design requirements"@en-US ;
    skos:definition "The values and conditions that a solution must satisfy, such as loads, temperatures, occupancy and service life."@en ;
    skos:scopeNote "Often from the owner's standards, the codes and the basis of design"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00373 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00295 ;
    skos:notation "aeco-00373" ;
    skos:prefLabel "Owner design standard"@en-US , "Client design standard"@en-GB ;
    skos:altLabel "design guidelines"@en-US ,
        "owner standards"@en-US ,
        "owner's criteria"@en-US ,
        "employer's standards"@en-GB ;
    skos:definition "The rules that one owner applies to all its projects, such as preferred products, systems, finishes and room layouts."@en ;
    skos:scopeNote "Not the same as Company standard (aeco-00280), which is a firm's own internal standard"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00374 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00295 ;
    skos:notation "aeco-00374" ;
    skos:prefLabel "Sustainability target"@en-US , "Sustainability target"@en-GB ;
    skos:altLabel "LEED target"@en-US ,
        "certification goal"@en-US ,
        "green building goal"@en-US ,
        "BREEAM target"@en-GB ;
    skos:definition "A goal for energy, water, carbon, materials or health, often linked to a rating system such as LEED."@en ;
    skos:scopeNote "Rating system names only. US: LEED, WELL, Green Globes. UK: BREEAM"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00296 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00012 ;
    skos:notation "aeco-00296" ;
    skos:prefLabel "Requirement types"@en-US , "Requirement types"@en-GB ;
    skos:altLabel "kinds of requirement"@en-US ;
    skos:definition "The kinds of need that a statement in a document can express, used to sort them by source and purpose."@en ;
    skos:scopeNote "An agent uses these to sort a requirement that it finds in a document"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00375 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00296 ;
    skos:notation "aeco-00375" ;
    skos:prefLabel "Functional requirement"@en-US , "Functional requirement"@en-GB ;
    skos:altLabel "functional need"@en-US ,
        "use requirement"@en-US ;
    skos:definition "A need that states what a facility or a system must do for its users, such as the activities that a room must support."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00376 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00296 ;
    skos:notation "aeco-00376" ;
    skos:prefLabel "Performance requirement"@en-US , "Performance requirement"@en-GB ;
    skos:altLabel "performance criterion"@en-US ,
        "performance target"@en-US ;
    skos:definition "A need that states how well a facility or a system must work, as a value that someone can measure and test."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00377 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00296 ;
    skos:notation "aeco-00377" ;
    skos:prefLabel "Statutory requirement"@en-US , "Statutory requirement"@en-GB ;
    skos:altLabel "code requirement"@en-US ,
        "legal requirement"@en-US ,
        "permit condition"@en-US ;
    skos:definition "A need that comes from a law, a code, a permit condition or a decision of an authority."@en ;
    skos:scopeNote "The rules themselves are in Regulations and permits"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00378 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00296 ;
    skos:notation "aeco-00378" ;
    skos:prefLabel "Contractual requirement"@en-US , "Contractual requirement"@en-GB ;
    skos:altLabel "contract obligation"@en-US ,
        "contract requirement"@en-US ;
    skos:definition "A duty that the contract places on a party, such as a response time, a notice period or a deliverable."@en ;
    skos:scopeNote "These feed the due date rules (context schema section 5)"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00379 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00296 ;
    skos:notation "aeco-00379" ;
    skos:prefLabel "Operational requirement"@en-US , "Operational requirement"@en-GB ;
    skos:altLabel "facility management requirement"@en-US ,
        "maintainability requirement"@en-US ;
    skos:definition "A need that makes a facility easy and safe to run, clean and maintain after handover, such as access to equipment."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00380 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00296 ;
    skos:notation "aeco-00380" ;
    skos:prefLabel "Aesthetic requirement"@en-US , "Aesthetic requirement"@en-GB ;
    skos:altLabel "appearance requirement"@en-US ,
        "visual requirement"@en-US ;
    skos:definition "A need for the look of a facility, such as its form, materials, colors and finishes."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00297 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00012 ;
    skos:notation "aeco-00297" ;
    skos:prefLabel "Constraints"@en-US , "Constraints"@en-GB ;
    skos:altLabel "limitations"@en-US ,
        "project constraints"@en-US ;
    skos:definition "The limits on money, time, space or operations that a project must work within."@en ;
    skos:scopeNote "A requirement says what the result must do. A constraint limits how the team can get there"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00381 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00297 ;
    skos:notation "aeco-00381" ;
    skos:prefLabel "Budget constraint"@en-US , "Budget constraint"@en-GB ;
    skos:altLabel "budget cap"@en-US ,
        "cost ceiling"@en-US ,
        "cost limit"@en-US ;
    skos:definition "A limit on the money that the owner will spend, which a design or a decision must not pass."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00382 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00297 ;
    skos:notation "aeco-00382" ;
    skos:prefLabel "Schedule constraint"@en-US , "Programme constraint"@en-GB ;
    skos:altLabel "deadline"@en-US ,
        "time constraint"@en-US ;
    skos:definition "A fixed date or time limit that the work must meet, such as an opening date or a work window."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00383 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00297 ;
    skos:notation "aeco-00383" ;
    skos:prefLabel "Site constraint"@en-US , "Site constraint"@en-GB ;
    skos:altLabel "access constraint"@en-US ,
        "logistics constraint"@en-US ,
        "space constraint"@en-US ;
    skos:definition "A limit that the location puts on the work, such as little space, poor access or close neighbors."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00384 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00297 ;
    skos:notation "aeco-00384" ;
    skos:prefLabel "Operational constraint"@en-US , "Operational constraint"@en-GB ;
    skos:altLabel "occupied building constraint"@en-US ,
        "live environment constraint"@en-GB ;
    skos:definition "A limit that comes from keeping a facility in use during the work, such as phasing around occupants or shutdown windows."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00298 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00012 ;
    skos:notation "aeco-00298" ;
    skos:prefLabel "Decision types"@en-US , "Decision types"@en-GB ;
    skos:altLabel "decision categories"@en-US ;
    skos:definition "The kinds of choice that parties make on a project, used to sort the choices that the ledger records."@en ;
    skos:scopeNote "A decision is an event. It lives in the ledger. The taxonomy holds only the types (context schema 4.5)"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00385 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00298 ;
    skos:notation "aeco-00385" ;
    skos:prefLabel "Design decision"@en-US , "Design decision"@en-GB ;
    skos:altLabel "design choice"@en-US ;
    skos:definition "A choice that the designers make about the form, systems, materials or details of a facility."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00386 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00298 ;
    skos:notation "aeco-00386" ;
    skos:prefLabel "Owner selection"@en-US , "Client selection"@en-GB ;
    skos:altLabel "finish selection"@en-US ,
        "owner choice"@en-US ,
        "owner decision"@en-US ;
    skos:definition "A choice that the owner makes among options that the team offers, such as finishes, equipment or layouts."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00387 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00298 ;
    skos:notation "aeco-00387" ;
    skos:prefLabel "Scope decision"@en-US , "Scope decision"@en-GB ;
    skos:altLabel "scope inclusion decision"@en-US ;
    skos:definition "A choice to add, remove or change work in a project or in one party's agreement."@en ;
    skos:scopeNote "The instrument is in Contracts and commercial, the event in Events and risks"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00388 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00298 ;
    skos:notation "aeco-00388" ;
    skos:prefLabel "Means and methods decision"@en-US ;
    skos:altLabel "construction method decision"@en-US ,
        "means and methods"@en-US ;
    skos:definition "A choice by the contractor of how to build the work, such as the sequence, equipment and temporary works."@en ;
    skos:scopeNote "Under most US contracts, means and methods are the contractor's duty"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00389 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00298 ;
    skos:notation "aeco-00389" ;
    skos:prefLabel "Procurement decision"@en-US , "Procurement decision"@en-GB ;
    skos:altLabel "award decision"@en-US ,
        "subcontractor selection"@en-US ,
        "vendor selection"@en-US ;
    skos:definition "A choice of which party, product or offer to buy from, with its basis, such as price or qualifications."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00390 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00298 ;
    skos:notation "aeco-00390" ;
    skos:prefLabel "Bid decision"@en-US , "Bid decision"@en-GB ;
    skos:altLabel "bid/no-bid decision"@en-US ,
        "go/no-go decision"@en-US ,
        "pursuit decision"@en-US ,
        "tender decision"@en-GB ;
    skos:definition "A choice by a firm whether to pursue a project and on what terms, made before it prepares an offer."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-who ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00391 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00298 ;
    skos:notation "aeco-00391" ;
    skos:prefLabel "Substitution decision"@en-US , "Substitution decision"@en-GB ;
    skos:altLabel "or-equal decision"@en-US ,
        "substitution approval"@en-US ;
    skos:definition "A choice to accept or reject a product or method that differs from the one that the contract documents name."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00392 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00298 ;
    skos:notation "aeco-00392" ;
    skos:prefLabel "Field decision"@en-US , "Site decision"@en-GB ;
    skos:altLabel "field direction"@en-US ,
        "field resolution"@en-US ;
    skos:definition "A choice that the site team makes to solve a problem during the work, often recorded later in an RFI or a change."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00299 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00012 ;
    skos:notation "aeco-00299" ;
    skos:prefLabel "Decision basis"@en-US , "Decision basis"@en-GB ;
    skos:altLabel "basis of decision"@en-US ,
        "decision support"@en-US ;
    skos:definition "The facts, options and reasons that support a choice, which the ledger records with it."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00393 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00299 ;
    skos:notation "aeco-00393" ;
    skos:prefLabel "Assumption"@en-US , "Assumption"@en-GB ;
    skos:altLabel "premise"@en-US ,
        "working assumption"@en-US ;
    skos:definition "A fact that a party takes as true without proof when it makes a decision or an estimate."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00394 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00299 ;
    skos:notation "aeco-00394" ;
    skos:prefLabel "Alternative"@en-US , "Alternative"@en-GB ;
    skos:altLabel "design option"@en-US ,
        "option"@en-US ;
    skos:definition "One of the options that a party considers before it makes a choice, including the options that it rejects."@en ;
    skos:scopeNote "Not a bid alternate, which is a priced option in a bid"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00395 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00299 ;
    skos:notation "aeco-00395" ;
    skos:prefLabel "Decision criterion"@en-US , "Decision criterion"@en-GB ;
    skos:altLabel "evaluation criterion"@en-US ,
        "selection criterion"@en-US ;
    skos:definition "A measure that a party uses to compare options, such as cost, time, risk or quality."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00396 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00299 ;
    skos:notation "aeco-00396" ;
    skos:prefLabel "Trade-off"@en-US , "Trade-off"@en-GB ;
    skos:altLabel "compromise"@en-US ;
    skos:definition "What a party gives up on one measure to gain on another when it chooses an option."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00397 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00299 ;
    skos:notation "aeco-00397" ;
    skos:prefLabel "Precedent"@en-US , "Precedent"@en-GB ;
    skos:altLabel "past practice"@en-US ,
        "prior decision"@en-US ;
    skos:definition "An earlier decision on a similar case that a party uses to support or guide a new decision."@en ;
    skos:scopeNote "Close to Lesson learned (aeco-00279), which records what to repeat or avoid"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00300 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00012 ;
    skos:notation "aeco-00300" ;
    skos:prefLabel "Deviations and waivers"@en-US , "Deviations and waivers"@en-GB ;
    skos:altLabel "exceptions"@en-US ;
    skos:definition "The accepted differences from a requirement, and the formal release from a duty to meet one."@en ;
    skos:scopeNote "A departure from a code or zoning rule is in Regulations and permits (Code modification, Variance)"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00398 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00300 ;
    skos:notation "aeco-00398" ;
    skos:prefLabel "Deviation"@en-US , "Deviation"@en-GB ;
    skos:altLabel "departure"@en-US ,
        "exception to the documents"@en-US ;
    skos:definition "A difference from a requirement of the contract documents that a party proposes or accepts, such as in a submittal."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00399 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00300 ;
    skos:notation "aeco-00399" ;
    skos:prefLabel "Waiver"@en-US , "Waiver"@en-GB ;
    skos:altLabel "requirement waiver"@en-US ;
    skos:definition "A formal release by a party of its right to enforce a requirement, in one case or for good."@en ;
    skos:scopeNote "Contract waivers such as Lien waiver (aeco-00152) are in Contracts and commercial"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-01047 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00300 ;
    skos:notation "aeco-01047" ;
    skos:prefLabel "Nonconforming work"@en-US , "Defective work"@en-GB ;
    skos:altLabel "defect"@en-US ,
        "defective work"@en-US ,
        "deficiency"@en-US ,
        "latent defect"@en-US ,
        "nonconformance"@en-US ;
    skos:definition "Installed items or material that do not meet the contract requirements and must be corrected, replaced or accepted as a deviation."@en ;
    skos:scopeNote "Minor items go on the Punch list (aeco-00263)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .
