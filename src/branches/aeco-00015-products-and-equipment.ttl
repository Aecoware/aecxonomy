aeco:aeco-00015 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00015" ;
    skos:prefLabel "Products and equipment"@en-US , "Products and equipment"@en-GB ;
    skos:altLabel "construction aid"@en-US ,
        "construction product"@en-US ,
        "plant"@en-GB ;
    skos:definition "A manufactured item or material that goes into a built asset, or a tool or machine that people use to do the work. Examples are a chiller, a door, gypsum board and a crane."@en ;
    skos:scopeNote "The purchase view: an item as people specify, buy, submit and warranty it, such as a chiller, a door leaf or gypsum board. The same item in its place, by what it does, is an element. Related links join the two views. Construction aids such as cranes never become elements"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Resources" ;
    aeco:depthLimit 4 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

