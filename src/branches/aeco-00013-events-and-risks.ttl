aeco:aeco-00013 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00013" ;
    skos:prefLabel "Events and risks"@en-US , "Events and risks"@en-GB ;
    skos:altLabel "occurrences"@en-US ;
    skos:definition "Something that happens during a project and changes its time, cost, quality or safety, or something that can happen. Examples are a delay, an incident and a fall hazard."@en ;
    skos:scopeNote "Delay, incident, claim, weather event, fall hazard. A risk may happen. An incident did"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Added" ;
    aeco:depthLimit 3 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-00026 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00013 ;
    skos:notation "aeco-00026" ;
    skos:prefLabel "Milestones"@en-US , "Milestones"@en-GB ;
    skos:altLabel "key dates"@en-US ,
        "project milestones"@en-US ;
    skos:definition "An event that marks the start or the end of a phase, or the date of a contract obligation."@en ;
    skos:scopeNote "Contract award, notice to proceed, substantial completion, final completion"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00046 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00026 ;
    skos:notation "aeco-00046" ;
    skos:prefLabel "Contract award"@en-US , "Contract award"@en-GB ;
    skos:altLabel "award"@en-US ;
    skos:definition "The milestone at which the owner selects a party for the work and both parties sign the agreement."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00047 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00026 ;
    skos:notation "aeco-00047" ;
    skos:prefLabel "Notice to proceed"@en-US ;
    skos:altLabel "NTP"@en-US ;
    skos:definition "The milestone at which the owner tells the contractor in writing to start the work, which often starts the contract time."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-aia , aeco:std-consensusdocs , aeco:std-dbia , aeco:std-ejcdc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00048 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00026 ;
    skos:notation "aeco-00048" ;
    skos:prefLabel "Substantial completion"@en-US ;
    skos:altLabel "date of substantial completion"@en-US ;
    skos:definition "The milestone at which the work is complete enough for the owner to use the asset for its purpose."@en ;
    skos:scopeNote "Close to practical completion under JCT"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-aia , aeco:std-consensusdocs , aeco:std-dbia , aeco:std-ejcdc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-28"^^xsd:date .

aeco:aeco-00049 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00026 ;
    skos:notation "aeco-00049" ;
    skos:prefLabel "Final completion"@en-US ;
    skos:definition "The milestone at which all work, including punch list items and closeout documents, is done and the last payment is due."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-aia , aeco:std-consensusdocs , aeco:std-dbia , aeco:std-ejcdc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00027 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00013 ;
    skos:notation "aeco-00027" ;
    skos:prefLabel "Changes"@en-US , "Changes"@en-GB ;
    skos:altLabel "change events"@en-US ,
        "scope changes"@en-US ;
    skos:definition "An event that alters the agreed scope, price or time of the work."@en ;
    skos:scopeNote "The event only. Change orders and other documents sit in Contracts and commercial or Information"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00050 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00027 ;
    skos:notation "aeco-00050" ;
    skos:prefLabel "Owner-requested change"@en-US , "Owner-requested change"@en-GB ;
    skos:altLabel "owner change"@en-US ,
        "owner-directed change"@en-US ;
    skos:definition "An event in which the client asks for scope, quality or time different from what the agreement states."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00051 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00027 ;
    skos:notation "aeco-00051" ;
    skos:prefLabel "Design change"@en-US , "Design change"@en-GB ;
    skos:altLabel "design revision"@en-US ;
    skos:definition "An event in which the architect or engineer revises the issued documents, for example to correct an error or omission."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00052 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00027 ;
    skos:notation "aeco-00052" ;
    skos:prefLabel "Differing site condition"@en-US ;
    skos:altLabel "DSC"@en-US ,
        "changed conditions"@en-US ,
        "concealed conditions"@en-US ;
    skos:definition "An event in which the contractor discovers hidden or unusual physical features on site that the contract documents did not show."@en ;
    skos:scopeNote "The ground and existing conditions themselves sit in Site and environment"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-where ;
    aeco:appliesUnder aeco:std-aia , aeco:std-consensusdocs , aeco:std-dbia , aeco:std-ejcdc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00053 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00027 ;
    skos:notation "aeco-00053" ;
    skos:prefLabel "Regulatory change"@en-US , "Regulatory change"@en-GB ;
    skos:altLabel "change in law"@en-US ,
        "code change"@en-US ;
    skos:definition "An event in which a new law, code or authority requirement takes effect after signing and affects the work."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00028 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00013 ;
    skos:notation "aeco-00028" ;
    skos:prefLabel "Delays"@en-US , "Delays"@en-GB ;
    skos:altLabel "schedule delays"@en-US ;
    skos:definition "An event that makes work finish later than the plan."@en ;
    skos:scopeNote "Classified by who carries the risk: excusable, compensable, non-excusable, concurrent"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00054 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00028 ;
    skos:notation "aeco-00054" ;
    skos:prefLabel "Excusable delay"@en-US ;
    skos:definition "A late finish that the contractor did not cause and could not control, which gives the contractor more time."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-aia , aeco:std-consensusdocs , aeco:std-dbia , aeco:std-ejcdc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00055 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00028 ;
    skos:notation "aeco-00055" ;
    skos:prefLabel "Compensable delay"@en-US ;
    skos:definition "An excusable late finish caused by the owner, which gives the contractor more time and money."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-aia , aeco:std-consensusdocs , aeco:std-dbia , aeco:std-ejcdc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00056 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00028 ;
    skos:notation "aeco-00056" ;
    skos:prefLabel "Non-excusable delay"@en-US ;
    skos:altLabel "contractor-caused delay"@en-US ,
        "inexcusable delay"@en-US ;
    skos:definition "A late finish that the contractor caused or could control, which gives no more time and can lead to damages."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-aia , aeco:std-consensusdocs , aeco:std-dbia , aeco:std-ejcdc ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00057 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00028 ;
    skos:notation "aeco-00057" ;
    skos:prefLabel "Concurrent delay"@en-US , "Concurrent delay"@en-GB ;
    skos:definition "Two or more late finishes from different causes that happen in the same period and affect the same completion date."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00029 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00013 ;
    skos:notation "aeco-00029" ;
    skos:prefLabel "Incidents"@en-US , "Incidents"@en-GB ;
    skos:altLabel "accidents"@en-US ,
        "safety incidents"@en-US ;
    skos:definition "An event that hurts a person, damages property or harms the environment, or nearly does so."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00058 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00029 ;
    skos:notation "aeco-00058" ;
    skos:prefLabel "Injury"@en-US , "Injury"@en-GB ;
    skos:altLabel "occupational injury"@en-US ,
        "work injury"@en-US ;
    skos:definition "An incident in which a person is hurt or becomes ill because of work."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00059 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00029 ;
    skos:notation "aeco-00059" ;
    skos:prefLabel "Near miss"@en-US , "Near miss"@en-GB ;
    skos:altLabel "close call"@en-US ,
        "near hit"@en-US ;
    skos:definition "An incident in which nobody is hurt and nothing is damaged, but harm almost happened."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00060 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00029 ;
    skos:notation "aeco-00060" ;
    skos:prefLabel "Property damage"@en-US , "Property damage"@en-GB ;
    skos:definition "An incident in which equipment, materials, finished work or a building nearby is damaged."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00061 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00029 ;
    skos:notation "aeco-00061" ;
    skos:prefLabel "Environmental release"@en-US , "Environmental release"@en-GB ;
    skos:altLabel "release"@en-US ,
        "spill"@en-US ;
    skos:definition "An incident in which a harmful substance escapes into the air, the soil or the water."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00030 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00013 ;
    skos:notation "aeco-00030" ;
    skos:prefLabel "Hazards"@en-US , "Hazards"@en-GB ;
    skos:altLabel "safety hazards"@en-US ;
    skos:definition "A condition or an action on site that can cause an incident."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00062 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00030 ;
    skos:notation "aeco-00062" ;
    skos:prefLabel "Fall hazard"@en-US , "Fall hazard"@en-GB ;
    skos:definition "A condition in which a person can fall to a lower level, for example from an edge, an opening or a ladder."@en ;
    skos:scopeNote "One of the OSHA Focus Four"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00063 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00030 ;
    skos:notation "aeco-00063" ;
    skos:prefLabel "Struck-by hazard"@en-US , "Struck-by hazard"@en-GB ;
    skos:definition "A condition in which a moving or falling object, vehicle or piece of equipment can hit a person."@en ;
    skos:scopeNote "One of the OSHA Focus Four"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00064 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00030 ;
    skos:notation "aeco-00064" ;
    skos:prefLabel "Caught-in or between hazard"@en-US , "Caught-in or between hazard"@en-GB ;
    skos:altLabel "caught-between hazard"@en-US ,
        "caught-in hazard"@en-US ;
    skos:definition "A condition in which objects, machine parts or a trench collapse can crush or trap a person."@en ;
    skos:scopeNote "One of the OSHA Focus Four"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00065 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00030 ;
    skos:notation "aeco-00065" ;
    skos:prefLabel "Electrical hazard"@en-US , "Electrical hazard"@en-GB ;
    skos:altLabel "electrocution hazard"@en-US ;
    skos:definition "A condition in which a person can touch live wires, parts or power lines and get a shock or a burn."@en ;
    skos:scopeNote "One of the OSHA Focus Four"@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-osha1926 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00031 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00013 ;
    skos:notation "aeco-00031" ;
    skos:prefLabel "Risks"@en-US , "Risks"@en-GB ;
    skos:altLabel "project risks"@en-US ;
    skos:definition "A possible event that, if it happens, changes the cost, time, quality or safety of a project."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00066 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00031 ;
    skos:notation "aeco-00066" ;
    skos:prefLabel "Cost risk"@en-US , "Cost risk"@en-GB ;
    skos:altLabel "budget risk"@en-US ;
    skos:definition "A risk that the project costs more than its budget."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00067 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00031 ;
    skos:notation "aeco-00067" ;
    skos:prefLabel "Schedule risk"@en-US , "Programme risk"@en-GB ;
    skos:altLabel "time risk"@en-US ;
    skos:definition "A risk that the project finishes later than its planned dates."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00068 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00031 ;
    skos:notation "aeco-00068" ;
    skos:prefLabel "Quality risk"@en-US , "Quality risk"@en-GB ;
    skos:definition "A risk that the work does not meet the required standard or specification."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00069 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00031 ;
    skos:notation "aeco-00069" ;
    skos:prefLabel "Safety risk"@en-US , "Safety risk"@en-GB ;
    skos:definition "A risk that a person gets hurt, or that the asset becomes unsafe to use or to build."@en ;
    aeco:primaryTag aeco:tag-why ;
    aeco:tag aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00032 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00013 ;
    skos:notation "aeco-00032" ;
    skos:prefLabel "Natural events"@en-US , "Natural events"@en-GB ;
    skos:altLabel "acts of God"@en-US ,
        "weather and natural events"@en-US ;
    skos:definition "Something in nature that affects work on site or the asset, such as severe weather, a flood or an earthquake."@en ;
    skos:scopeNote "The event only. Climate and ground conditions sit in Site and environment"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00070 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00032 ;
    skos:notation "aeco-00070" ;
    skos:prefLabel "Severe weather"@en-US , "Severe weather"@en-GB ;
    skos:altLabel "adverse weather"@en-US ,
        "inclement weather"@en-US ;
    skos:definition "Rain, snow, wind, heat or cold strong enough to stop or slow work, or to damage work in place."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00071 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00032 ;
    skos:notation "aeco-00071" ;
    skos:prefLabel "Flood"@en-US , "Flood"@en-GB ;
    skos:altLabel "flooding"@en-US ;
    skos:definition "Water that covers land or enters a site or an asset where it is usually dry."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00072 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00032 ;
    skos:notation "aeco-00072" ;
    skos:prefLabel "Earthquake"@en-US , "Earthquake"@en-GB ;
    skos:altLabel "seismic event"@en-US ;
    skos:definition "A sudden movement of the ground that can damage structures and stop work."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00073 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00032 ;
    skos:notation "aeco-00073" ;
    skos:prefLabel "Wildfire"@en-US , "Wildfire"@en-GB ;
    skos:altLabel "forest fire"@en-US ;
    skos:definition "An uncontrolled fire in vegetation that can reach or threaten a site or an asset."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-01048 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00032 ;
    skos:notation "aeco-01048" ;
    skos:prefLabel "Weather conditions"@en-US , "Weather conditions"@en-GB ;
    skos:altLabel "daily weather"@en-US ,
        "site weather"@en-US ,
        "weather"@en-US ;
    skos:definition "The temperature, rain, snow and wind on site on a given day, as the daily report records them."@en ;
    skos:scopeNote "Weather beyond normal is Severe weather (aeco-00070)"@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .

aeco:aeco-01049 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00032 ;
    skos:notation "aeco-01049" ;
    skos:prefLabel "Scour"@en-US , "Scour"@en-GB ;
    skos:altLabel "bridge scour"@en-US ,
        "streambed scour"@en-US ;
    skos:definition "The removal of soil around bridge piers, abutments or culverts by flowing water, which can undermine the foundations."@en ;
    aeco:primaryTag aeco:tag-when ;
    aeco:tag aeco:tag-when , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .
