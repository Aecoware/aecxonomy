    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00281 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00191 ;
    skos:notation "aeco-00281" ;
    skos:prefLabel "BIM execution plan"@en-US , "BIM execution plan"@en-GB ;
    skos:altLabel "BEP"@en-US ,
        "BxP"@en-US ;
    skos:definition "A plan that sets how a team will create, share and check models and data on a project."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00282 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00191 ;
    skos:notation "aeco-00282" ;
    skos:prefLabel "Information requirements"@en-US , "Information requirements"@en-GB ;
    skos:altLabel "EIR"@en-US ,
        "OIR"@en-US ,
        "exchange information requirements"@en-US ;
    skos:definition "The statement of what data and documents an owner needs, in what form and when, from each party."@en ;
    skos:scopeNote "ISO 19650 terms by name only"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00283 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00191 ;
    skos:notation "aeco-00283" ;
    skos:prefLabel "Naming convention"@en-US , "Naming convention"@en-GB ;
    skos:altLabel "file naming standard"@en-US ;
    skos:definition "The agreed rules for the names of files, models and objects so that people and software can find them."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00284 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00191 ;
    skos:notation "aeco-00284" ;
    skos:prefLabel "Document register"@en-US , "Document register"@en-GB ;
    skos:altLabel "document log"@en-US ,
        "drawing register"@en-US ,
        "drawing schedule"@en-GB ;
    skos:definition "A list of all project files and sheets with their numbers, titles, revisions and status."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00285 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00191 ;
    skos:notation "aeco-00285" ;
    skos:prefLabel "Common data environment"@en-US , "Common data environment"@en-GB ;
    skos:altLabel "CDE"@en-US ;
    skos:definition "The agreed single source of information for a project, where files are shared, reviewed and approved."@en ;
    skos:scopeNote "ISO 19650 term by name only"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00950 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00191 ;
    skos:notation "aeco-00950" ;
    skos:prefLabel "Information container"@en-US , "Information container"@en-GB ;
    skos:altLabel "container"@en-US ;
    skos:definition "A named file, model, sheet set or dataset that a team stores, shares, reviews and tracks as one item."@en ;
    skos:scopeNote "Term from ISO 19650. Lives in a Common data environment (aeco-00285)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00926 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00008 ;
    skos:notation "aeco-00926" ;
    skos:prefLabel "Project plans"@en-US , "Project plans"@en-GB ;
    skos:altLabel "execution plans"@en-US ,
        "management plans"@en-US ;
    skos:definition "Documents that set out how the team will manage one aspect of the work, such as safety, quality or logistics, before it starts."@en ;
    skos:scopeNote "The BIM execution plan (aeco-00281) stays in Information management"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00929 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00926 ;
    skos:notation "aeco-00929" ;
    skos:prefLabel "Project management plan"@en-US , "Project execution plan"@en-GB ;
    skos:altLabel "PEP"@en-US ,
        "project execution plan"@en-US ,
        "PEP"@en-GB ;
    skos:definition "The top document that states how the team will deliver the work: scope, organization, controls, reporting and the other plans it governs."@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00930 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00926 ;
    skos:notation "aeco-00930" ;
    skos:prefLabel "Site-specific safety plan"@en-US , "Construction phase plan"@en-GB ;
    skos:altLabel "HASP"@en-US ,
        "SSSP"@en-US ,
        "health and safety plan"@en-US ,
        "site safety plan"@en-US ,
        "CPP"@en-GB ,
        "construction phase health and safety plan"@en-GB ;
    skos:definition "The written plan for one site that names its hazards, the controls for each and the people who answer for them."@en ;
    skos:scopeNote "CDM 2015 requires a construction phase plan in the UK. The process is Safety planning (aeco-00219)"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how , aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00931 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00926 ;
    skos:notation "aeco-00931" ;
    skos:prefLabel "Quality plan"@en-US , "Quality plan"@en-GB ;
    skos:altLabel "QMP"@en-US ,
        "project quality plan"@en-US ,
        "quality management plan"@en-US ;
    skos:definition "The plan that states the inspections, tests, hold points and records that prove the work meets the contract."@en ;
    skos:scopeNote "The processes are Quality control (aeco-00217) and Quality assurance (aeco-00218)"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00932 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00926 ;
    skos:notation "aeco-00932" ;
    skos:prefLabel "Commissioning plan"@en-US , "Commissioning plan"@en-GB ;
    skos:altLabel "Cx plan"@en-US ,
        "commissioning process plan"@en-US ;
    skos:definition "The plan that sets the scope, team, schedule and test procedures that verify building systems work as the owner requires."@en ;
    skos:scopeNote "Based on the Owner's project requirements (aeco-00368)"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00933 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00926 ;
    skos:notation "aeco-00933" ;
    skos:prefLabel "Site logistics plan"@en-US , "Site logistics plan"@en-GB ;
    skos:altLabel "crane and laydown plan"@en-US ,
        "site utilization plan"@en-US ;
    skos:definition "The drawing and notes that show how a site works during construction: access, cranes, laydown, staging, parking and deliveries."@en ;
    skos:scopeNote "The process is Site logistics (aeco-00211)"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00934 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00926 ;
    skos:notation "aeco-00934" ;
    skos:prefLabel "Stormwater pollution prevention plan"@en-US , "Pollution prevention plan"@en-GB ;
    skos:altLabel "SWPPP"@en-US ,
        "stormwater plan"@en-US ,
        "PPP"@en-GB ;
    skos:definition "The site document that lists the measures that keep sediment and pollutants out of storm drains and waters during construction."@en ;
    skos:scopeNote "Required by the Stormwater permit (aeco-00356). The measures are Erosion and sediment control (aeco-00699)"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00935 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00926 ;
    skos:notation "aeco-00935" ;
    skos:prefLabel "Work plan"@en-US , "Method statement"@en-GB ;
    skos:altLabel "AHA"@en-US ,
        "activity hazard analysis"@en-US ,
        "installation plan"@en-US ,
        "means and methods plan"@en-US ,
        "RAMS"@en-GB ,
        "risk assessment and method statement"@en-GB ;
    skos:definition "The document that sets out how a crew will do one activity: steps, sequence, equipment, hazards and controls."@en ;
    skos:scopeNote "Covers one activity. The whole-project document is the Project management plan"@en ;
    aeco:primaryTag aeco:tag-how ;
    aeco:tag aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00927 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00008 ;
    skos:notation "aeco-00927" ;
    skos:prefLabel "Investigations and studies"@en-US , "Investigations and studies"@en-GB ;
    skos:altLabel "site investigations"@en-US ,
        "surveys and reports"@en-US ;
    skos:definition "Reports that record facts about a site, a building or a design question, gathered by testing, surveying or analysis."@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00936 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00927 ;
    skos:notation "aeco-00936" ;
    skos:prefLabel "Geotechnical report"@en-US , "Ground investigation report"@en-GB ;
    skos:altLabel "geotech report"@en-US ,
        "geotechnical investigation"@en-US ,
        "soils report"@en-US ,
        "subsurface investigation report"@en-US ,
        "GIR"@en-GB ,
        "site investigation report"@en-GB ;
    skos:definition "The engineer's findings on soil, rock and groundwater from borings and tests, with advice for foundations and earthwork."@en ;
    skos:scopeNote "Describes the Subsurface conditions (aeco-00302)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00937 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00927 ;
    skos:notation "aeco-00937" ;
    skos:prefLabel "Environmental site assessment"@en-US , "Land contamination assessment"@en-GB ;
    skos:altLabel "ESA"@en-US ,
        "Phase I ESA"@en-US ,
        "Phase II ESA"@en-US ,
        "contaminated land assessment"@en-GB ,
        "desk study"@en-GB ;
    skos:definition "A study of past and present land use that finds if soil or groundwater on a property is likely to be contaminated."@en ;
    skos:scopeNote "Finds Contaminated ground (aeco-00409). Phase I reviews records under ASTM E1527. Phase II takes samples"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what , aeco:tag-why ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00938 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00927 ;
    skos:notation "aeco-00938" ;
    skos:prefLabel "Hazardous materials survey"@en-US , "Hazardous materials survey"@en-GB ;
    skos:altLabel "asbestos survey"@en-US ,
        "hazmat survey"@en-US ,
        "pre-demolition survey"@en-US ,
        "pre-renovation survey"@en-US ,
        "asbestos survey"@en-GB ,
        "refurbishment and demolition survey"@en-GB ;
    skos:definition "An inspection of a building that finds and samples asbestos, lead paint and other harmful substances before work disturbs them."@en ;
    skos:scopeNote "Finds Hazardous building material (aeco-00431)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00939 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00927 ;
    skos:notation "aeco-00939" ;
    skos:prefLabel "Existing conditions survey"@en-US , "Measured building survey"@en-GB ;
    skos:altLabel "as-found survey"@en-US ,
        "existing conditions documentation"@en-US ,
        "field verification survey"@en-US ,
        "condition survey"@en-GB ,
        "measured survey"@en-GB ;
    skos:definition "A record of a building or site as it stands, with dimensions, features and defects, made before design or construction starts."@en ;
    skos:scopeNote "Laser scanning gives a Point cloud (aeco-00244)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00940 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00927 ;
    skos:notation "aeco-00940" ;
    skos:prefLabel "Topographic survey"@en-US , "Topographical survey"@en-GB ;
    skos:altLabel "topo"@en-US ,
        "topo survey"@en-US ,
        "topo survey"@en-GB ;
    skos:definition "A measured map of ground levels, contours and visible features such as buildings, trees and utilities on a site."@en ;
    skos:scopeNote "Done by a Land surveyor (aeco-00122). Records the Topography (aeco-00412)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-00941 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00927 ;
    skos:notation "aeco-00941" ;
    skos:prefLabel "Boundary survey"@en-US , "Boundary survey"@en-GB ;
    skos:altLabel "ALTA survey"@en-US ,
        "ALTA/NSPS land title survey"@en-US ,
        "property survey"@en-US ;
    skos:definition "A measured map that fixes the property lines, corners, easements and encroachments of a parcel."@en ;
    skos:scopeNote "Shows the Property line (aeco-00401) and any Easement (aeco-00402)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what , aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

aeco:aeco-01051 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00927 ;
    skos:notation "aeco-01051" ;
    skos:prefLabel "Boring log"@en-US , "Borehole log"@en-GB ;
    skos:altLabel "boring"@en-US ,
        "drill log"@en-US ,
        "soil boring"@en-US ,
        "test boring"@en-US ,
        "borehole record"@en-GB ;
    skos:definition "A record of one test hole that lists the soil layers, sample results, groundwater level and test values with depth."@en ;
    skos:scopeNote "Usually part of a Geotechnical report (aeco-00936)"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:modified "2026-10-26"^^xsd:date .
