aeco:aeco-00008 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00008" ;
    skos:prefLabel "Information"@en-US , "Information"@en-GB ;
    skos:altLabel "construction information"@en-US ,
        "documentation"@en-US ,
        "project information"@en-US ;
    skos:definition "Recorded content that people use to design, build, operate or manage a built asset. Examples are drawings, models, specifications and RFIs."@en ;
    skos:scopeNote "Drawings, specifications, models, RFIs, submittals, reports"@en ;
    aeco:primaryTag aeco:tag-what ;
    aeco:tag aeco:tag-what , aeco:tag-how ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Resources" ;
    aeco:depthLimit 3 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

