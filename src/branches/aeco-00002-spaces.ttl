aeco:aeco-00527 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00444 ;
    skos:notation "aeco-00527" ;
    skos:prefLabel "Level"@en-US , "Storey"@en-GB ;
