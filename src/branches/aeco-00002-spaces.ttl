aeco:aeco-00002 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:topConceptOf aeco:base ;
    skos:notation "aeco-00002" ;
    skos:prefLabel "Spaces"@en-US , "Spaces"@en-GB ;
    skos:altLabel "built space"@en-US ;
    skos:definition "An area or volume, inside or around a built asset, that has limits people can identify. Examples are a room, a zone and a data hall."@en ;
    skos:scopeNote "Rooms, zones, data halls, corridors"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    aeco:group "Results" ;
    aeco:depthLimit 3 ;
    dct:created "2026-10-24"^^xsd:date ;
    dct:modified "2026-10-24"^^xsd:date .

aeco:aeco-00444 a skos:Concept ;
    skos:inScheme aeco:base ;
    skos:broader aeco:aeco-00002 ;
    skos:notation "aeco-00444" ;
    skos:prefLabel "Spatial structure"@en-US , "Spatial structure"@en-GB ;
    skos:altLabel "location breakdown"@en-US ,
        "spatial breakdown"@en-US ;
    skos:definition "The levels and parts that people use to say where something is in a built asset."@en ;
    skos:scopeNote "Like the IFC spatial structure: site, building, story, space"@en ;
    aeco:primaryTag aeco:tag-where ;
