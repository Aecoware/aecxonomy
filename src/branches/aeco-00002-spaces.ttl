        "floor"@en-US ,
        "story"@en-US ,
        "floor"@en-GB ,
        "storey"@en-GB ;
    skos:definition "One horizontal division of a building between a floor and the floor or roof above it."@en ;
    skos:scopeNote "Drawings, models and site reports say level (Level 3). Codes say story (IBC) or storey (UK Building Regulations). A datum such as top of steel is not a level here"@en ;
    aeco:primaryTag aeco:tag-where ;
    aeco:tag aeco:tag-where ;
    aeco:appliesUnder aeco:std-shared ;
    dct:created "2026-10-25"^^xsd:date ;
    dct:modified "2026-10-25"^^xsd:date .

